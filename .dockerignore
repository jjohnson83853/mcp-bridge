# Keep the build context to sources plus module metadata. This repo carries a
# committed 17 MB local binary and a 2 MB coverage profile; neither may be sent
# to the daemon.
.git
.gitignore
.omp
.omo
.omc
.superpowers
.claude
.codegraph

mcp-bridge
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
.*.buffer
.*.count

# Operator state and secrets referenced by config documents
data/
configs/secrets/
.env
.env.*
