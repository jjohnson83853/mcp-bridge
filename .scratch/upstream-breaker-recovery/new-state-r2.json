  "requirements": [
    {
      "id": "R1",
      "summary": "Latched-open per-server circuit breaker regains reachable close path via non-executing discovery probe"
    },
    {
      "id": "R2",
      "summary": "Dedicated.Discover claims half-open probe via ServerClient.BeginProbe and completes once on discovery outcome"
    },
    {
      "id": "R3",
      "summary": "AdmitCall and CallTool do not claim, complete, or replay probes; tool calls stay rejected while open or probing"
    },
    {
      "id": "R4",
      "summary": "Probe reuses existing Discover acquisition verbatim (stateless:true opens fresh ephemeral connection)"
    },
    {
      "id": "R5",
      "summary": "Periodic refresh and SIGHUP/reload invoke same Discover close path without process restart"
    },
    {
      "id": "R6",
      "summary": "At most one probe in flight per server; concurrent discovery runs plain without mutating breaker"
    },
    {
      "id": "R7",
      "summary": "Observability reuses existing signals without new metric series, label, or custom event"
    },
    {
      "id": "R8",
      "summary": "Stateless probe boundary documented; stateful cached session limitation preserved for ticket 2"
    }
  ],
