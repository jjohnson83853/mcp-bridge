test('dispatch payload rejects missing, empty, and out-of-range solutionSpace descriptions', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  for (const solutionSpace of ['', ' ', 'x'.repeat(1_001), undefined, 42]) {
    const task = { ...payload.tasks[0] };
    if (solutionSpace === undefined) delete task.solutionSpace;
    else task.solutionSpace = solutionSpace;
    assertPayloadFailure({ ...payload, tasks: [task] }, 'E_INVALID_SOLUTION_SPACE', 'task.solutionSpace');
  }
  for (const solutionSpace of ['a', 'TODO', 'Fix', 'fix', 'none', 'Fix the null dereference in parser.ts', 'fix later', 'none of the above', 'x'.repeat(1_000)]) {
    assert.equal(gateApi.validateDispatchPayload({
      ...payload,
      tasks: [{ ...payload.tasks[0], solutionSpace }],
    }).ok, true);
  }
});

test('dispatch payload accepts the concurrency and size limits', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const tasks = Array.from({ length: 3 }, (_, index) => ({
    ...payload.tasks[0],
    name: `Research ${index + 1}`,
  }));
  const wrapper = JSON.parse(payload.context);
  wrapper.workflowDispatch.requests = tasks.map((task, index) => ({
    name: task.name,
    taskId: `research0${index + 1}`,
    agent: task.agent,
    effects: { kind: 'read', paths: ['spec.md'] },
  }));
  const pointer = '\n.omp/artifacts/payload.txt';
  tasks[0].task = 'x'.repeat(32_768 - pointer.length) + pointer;
  tasks[0].solutionSpace = 'x'.repeat(1_000);
  tasks[1].solutionSpace = '12345';

  assert.deepEqual(gateApi.validateDispatchPayload({
    ...payload,
    context: JSON.stringify(wrapper),
    tasks,
  }), { ok: true, shape: 'batch' });
});
test('flat dispatch accepts a serialized wrapper above 4_000 characters', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const wrapper = JSON.parse(payload.context);
  wrapper.instructions = 'x'.repeat(3_900);
  const flat = { ...payload.tasks[0], task: JSON.stringify(wrapper) };
  assert.ok(flat.task.length > 4_000);
  assert.deepEqual(gateApi.validateDispatchPayload(flat), { ok: true, shape: 'flat' });
});


test('check-payload CLI accepts valid payloads and emits structured lint failures', t => {
  const dir = mkdtempSync(path.join(tmpdir(), 'execution-gate-payload-'));
  t.after(() => rmSync(dir, { recursive: true, force: true }));
  const payloadPath = path.join(dir, 'payload.json');
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;

  writeFileSync(payloadPath, JSON.stringify(payload));
  const accepted = spawnSync(process.execPath, [CLI_PATH, 'check-payload', payloadPath], { encoding: 'utf8' });
  assert.equal(accepted.status, 0, accepted.stderr);
  assert.deepEqual(JSON.parse(accepted.stdout), { ok: true, shape: 'batch' });

  const invalid = structuredClone(payload);
  invalid.tasks[0].solutionSpace = '';
  writeFileSync(payloadPath, JSON.stringify(invalid));
  const denied = spawnSync(process.execPath, [CLI_PATH, 'check-payload', payloadPath], { encoding: 'utf8' });
  assert.equal(denied.status, 1, denied.stderr);
  const output = JSON.parse(denied.stdout);
  assert.equal(output.ok, false);
  assert.equal(output.code, 'E_INVALID_SOLUTION_SPACE');
  assert.equal(output.field, 'task.solutionSpace');
  assert.equal(typeof output.detail, 'string');
  assert.deepEqual(output.reasons.map(({ code }) => code), ['E_INVALID_SOLUTION_SPACE']);
  const rawTask = `service=worker task_id=research01 event=dispatch_denied ${'x'.repeat(32_769)}`;
  const raw = structuredClone(payload);
  raw.tasks[0].task = rawTask;
  writeFileSync(payloadPath, JSON.stringify(raw));
  const oversizedDenied = spawnSync(process.execPath, [CLI_PATH, 'check-payload', payloadPath], { encoding: 'utf8' });
  assert.equal(oversizedDenied.status, 1, oversizedDenied.stderr);
  assert.equal(oversizedDenied.stderr, '');
  const oversizedOutput = JSON.parse(oversizedDenied.stdout);
  assert.equal(oversizedOutput.code, 'E_PAYLOAD_TOO_LARGE');
  assert.equal(oversizedOutput.field, 'task.size');
  assert.equal(oversizedOutput.detail.includes(rawTask), false);
  assert.equal(oversizedDenied.stdout.includes('service=worker'), false);
});

test('live gate logs a payload-free oversized-task denial', async t => {
  const { fixture, logs, call } = setup(t);
  const event = dispatchEvent(fixture);
  const rawTask = `service=worker task_id=research01 event=dispatch_denied ${'x'.repeat(32_769)}`;
  event.input.tasks[0].task = rawTask;
  const result = await call(event);
  assert.equal(result?.block, true);
  assert.match(result.reason, /E_PAYLOAD_TOO_LARGE/);
  assert.deepEqual(logs.at(-1), { event: 'dispatch_denied', code: 'E_PAYLOAD_TOO_LARGE' });
  assert.equal(JSON.stringify(logs).includes('service=worker'), false);
});

test('live gate preserves typed payload-lint denials', async t => {
  const { fixture, logs, call } = setup(t);
  const event = dispatchEvent(fixture);
  event.input.tasks[0].solutionSpace = '';
  const result = await call(event);
  assert.match(result.reason, /E_INVALID_SOLUTION_SPACE/);
  assert.equal(logs.at(-1).code, 'E_INVALID_SOLUTION_SPACE');
});

test('native shape contract rejects missing task content and duplicate mapping before dispatch', () => {
  for (const change of [
    task => ({ ...task, task: '' }),
    task => ({ ...task, solutionSpace: ' ' }),
    task => ({ ...task, unknown: true }),
  ]) {
    const seed = dispatchSeed();
    seed.tasks = seed.tasks.map(change);
    assert.equal(gateApi.buildDispatchPayload(seed).ok, false);
  }
  const seed = dispatchSeed();
  seed.workflowDispatch.requests.push({ ...seed.workflowDispatch.requests[0], name: 'Other', taskId: 'other01' });
  seed.tasks.push({ ...seed.tasks[0] });
  assert.equal(gateApi.buildDispatchPayload(seed).ok, false);
});

test('batch and flat shape validator use the same wrapper/native contract', () => {
  const seed = dispatchSeed();
  const built = gateApi.buildDispatchPayload(seed);
  const flat = { ...seed.tasks[0], task: built.payload.context };
  assert.deepEqual(gateApi.validateDispatchPayload(flat), { ok: true, shape: 'flat' });
  for (const [field, value] of Object.entries({ effort: 'hi', outputSchema: { type: 'object' }, schemaMode: 'strict', isolated: true })) {
    const payload = structuredClone(built.payload);
    payload.tasks[0][field] = value;
    assert.equal(gateApi.validateDispatchPayload(payload).ok, true);
  }
  for (const outputSchema of [true, false, '{"type":"string"}', null]) {
    assert.equal(gateApi.buildDispatchPayload({ ...seed, tasks: [{ ...seed.tasks[0], outputSchema }] }).ok, true);
  }
  for (const [field, value] of [['effort', 'installed-value'], ['schemaMode', 'installed-value'], ['outputSchema', []], ['outputSchema', 42], ['isolated', 'true']]) {
    const payload = structuredClone(built.payload);
    payload.tasks[0][field] = value;
    assert.equal(gateApi.validateDispatchPayload(payload).ok, false, field);
  }
});

test('workflow dispatch accepts optional nonempty target pairs and keeps strict unknown-field rejection', () => {
  const legacy = gateApi.buildDispatchPayload(dispatchSeed());
  assert.equal(legacy.ok, true);
  assert.deepEqual(gateApi.validateDispatchPayload(legacy.payload), { ok: true, shape: 'batch' });

  const seed = dispatchSeed();
  Object.assign(seed.workflowDispatch.requests[0], {
    targetCandidateId: 'candidate-r1', targetRevision: 'r1',
  });
  const built = gateApi.buildDispatchPayload(seed);
  assert.equal(built.ok, true);
  assert.deepEqual(gateApi.validateDispatchPayload(built.payload), { ok: true, shape: 'batch' });

  for (const [field, value] of [['targetCandidateId', ''], ['targetRevision', 7], ['unexpected', true]]) {
    const payload = structuredClone(built.payload);
    const wrapper = JSON.parse(payload.context);
    wrapper.workflowDispatch.requests[0][field] = value;
    payload.context = JSON.stringify(wrapper);
    const invalid = gateApi.validateDispatchPayload(payload);
    assert.equal(invalid.ok, false, field);
    assert.equal(invalid.code, 'E_DISPATCH_METADATA', field);
  }
});

for (const [field, value] of [['effort', 'invalid'], ['schemaMode', 'invalid'], ['isolated', 'true'], ['outputSchema', []]]) test(`optional ${field} values fail builder and live admission consistently`, async t => {
  const seed = dispatchSeed();
  seed.tasks[0][field] = value;
  assert.equal(gateApi.buildDispatchPayload(seed).ok, false);
  const ctx = setup(t);
  const event = dispatchEvent(ctx.fixture);
  event.input.tasks[0][field] = value;
  assert.match((await ctx.call(event)).reason, /E_DISPATCH_MISMATCH/);
});

for (const [left, right, alias, denied] of [
  ['src/', 'src/fixture.txt', false, true],
  ['src/missing/', 'src/missing/new.txt', false, true],
  ['src/fixture.txt', 'alias/fixture.txt', true, true],
  ['src/a.txt', 'src/b.txt', false, false],
  ['src/a', 'src/ab', false, false],
]) test(`concurrent mutation scopes ${left} / ${right} enforce canonical overlap`, async t => {
  const ctx = setup(t, (s, root) => {
    if (alias) symlinkSync(path.join(root, 'src'), path.join(root, 'alias'));
    const task = s.tasks.find(task => task.id === 'impl02');
    task.effects.paths = [left];
    task.blockedBy = [];
    Object.assign(s.tasks.find(task => task.id === 'research01'), {
      stage: 'implementation', status: 'pending', evidenceIds: [], agentRoles: ['engineer'],
      effects: { kind: 'write', paths: [right] },
    });
  });
  const entries = [left, right].map((p, index) => ({
    name: `Writer${index}`, taskId: index ? 'research01' : 'impl02', agent: 'engineer', effects: { kind: 'write', paths: [p] },
  }));
  const request = JSON.parse(dispatchEvent(ctx.fixture, entries).input.context).workflowDispatch;
  const { statePath, ...authorityRequest } = request;
  assert.equal(evaluateDispatch(statePath, authorityRequest).allowed, true);
  const result = await ctx.call(dispatchEvent(ctx.fixture, entries));
  assert.equal(result?.block === true, denied);
  if (denied) assert.match(result.reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
});

test('scope preflight permits shared reads and same-task paths, fails closed on unavailable or escaped paths', t => {
  const fixture = runtimeFixture(t);
  const request = paths => ({ projectRoot: fixture.root, requests: paths });
  const effect = (kind, paths) => ({ effects: { kind, paths } });
  assert.equal(gateApi.dispatchScopeError(request([
    effect('read', ['spec.md']), effect('read', ['spec.md']),
  ])), null);
  assert.equal(gateApi.dispatchScopeError(request([
    effect('write', ['src/', 'src/fixture.txt']),
  ])), null);
  assert.equal(gateApi.dispatchScopeError(request([effect('write', ['/outside-root/new.txt'])])), 'E_PATH_ESCAPE');
  symlinkSync(path.join(fixture.root, 'absent-target'), path.join(fixture.root, 'broken'));
  assert.equal(gateApi.dispatchScopeError(request([effect('write', ['broken/new.txt'])])), 'E_PATH_ESCAPE');
});

function activeWriters(t, secondPath = 'src/fixture.txt', deps = {}) {
  const ctx = setup(t, (s, root) => {
    symlinkSync(path.join(root, 'src'), path.join(root, 'alias'));
    s.tasks.find(task => task.id === 'impl02').blockedBy = [];
    Object.assign(s.tasks.find(task => task.id === 'research01'), {
      stage: 'implementation', status: 'pending', evidenceIds: [], agentRoles: ['engineer'],
      effects: { kind: 'write', paths: [secondPath] },
    });
  }, deps);
  const event = (id, taskId, p, name) => ({
    ...dispatchEvent(ctx.fixture, [{ name, taskId, agent: 'engineer', effects: { kind: 'write', paths: [p] } }]),
    toolCallId: id,
  });
  return { ...ctx, first: event('call-a', 'impl02', 'src/', 'WriterA'),
    second: event('call-b', 'research01', secondPath, 'WriterB'), context: { cwd: ctx.fixture.root, agent: { id: 'Main' } } };
}

function updateFixtureRevision(fixture, revision) {
  fixture.state.revision = revision;
  const markerPath = path.join(fixture.root, 'gate/marker.json');
  const marker = JSON.parse(readFileSync(markerPath, 'utf8'));
  marker.revision = revision;
  writeFileSync(fixture.statePath, JSON.stringify(fixture.state));
  writeFileSync(markerPath, JSON.stringify(marker));
}

test('active scopes reject separate-call symlink aliases until actual child completion, not async ack', async t => {
  const ctx = activeWriters(t, 'alias/fixture.txt');
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    async: { state: 'running' }, progress: [{ index: 0, id: 'UniquifiedWriterA' }],
  } }, ctx.context);
  ctx.gate.onAgentRegistryChange([{ id: 'WriterA', status: 'idle', parentId: 'Main' }]);
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  ctx.gate.onAgentRegistryChange([{ id: 'UniquifiedWriterA', status: 'idle', parentId: 'Main' }]);
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
});

test('active reservation admission is atomic across concurrent calls', async t => {
  const ctx = activeWriters(t);
  const results = await Promise.all([ctx.first, ctx.second].map(event => ctx.gate.handleToolCall(event, ctx.context)));
  assert.equal(results.filter(value => value === undefined).length, 1);
  assert.equal(results.filter(value => value?.block === true).length, 1);
});

for (const result of [{ exitCode: 1, error: 'launch failed' }, { exitCode: 0 }, { aborted: true }]) test(`active scopes release on native settled result ${JSON.stringify(result)}`, async t => {
  const ctx = activeWriters(t);
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'ActualWriterA', ...result }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
});

test('active scopes allow independent writes and reject unrelated completion evidence', async t => {
  const ctx = activeWriters(t, 'src-other/file.txt');
  ctx.fixture.state.envelope.writePaths.push('src-other/');
  writeFileSync(ctx.fixture.statePath, JSON.stringify(ctx.fixture.state));
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'unrelated', details: { results: [{ index: 0, exitCode: 0 }] } }, ctx.context);
  const third = { ...ctx.first, toolCallId: 'call-c' };
  assert.match((await ctx.gate.handleToolCall(third, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
});

test('active scopes retain a failed-launch reservation while queued jobs are absent from the registry', async t => {
  // A partially scheduled native call can queue jobs that the registry has not
  // registered yet, so an empty registry plus a task-level isError and no
  // per-item terminal result must not release the overlapping reservation.
  const ctx = activeWriters(t, 'src/fixture.txt', { getAgentRegistry: () => [] });
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', isError: true, details: { results: [], progress: [] } }, ctx.context);
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'ActualWriterA', exitCode: 1, error: 'launch failed' }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
});

test('active scopes retain failed-launch reservations when child evidence is unavailable or ambiguous', async t => {
  const children = [];
  const ctx = activeWriters(t, 'src/fixture.txt', { getAgentRegistry: () => children });
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  children.push({ id: 'UnknownFreshChild', parentId: 'Main', status: 'running' });
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', isError: true }, ctx.context);
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
});


test('settled writer resumption is interlocked while an overlapping reservation is active', async t => {
  const ctx = activeWriters(t);
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
  const resume = { toolName: 'write', input: { path: 'agent://SettledWriterA', content: 'resume the implementation task' } };
  const blocked = await ctx.gate.handleToolCall(resume, ctx.context);
  assert.equal(blocked?.block, true);
  assert.match(blocked.reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  // Non-mutating and unknown targets are not writers and stay writable.
  assert.equal(await ctx.gate.handleToolCall({ toolName: 'write', input: { path: 'agent://ReadOnlyChild', content: 'note' } }, ctx.context), undefined);
  // The interlock clears once the overlapping writer settles.
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-b', details: {
    results: [{ index: 0, id: 'SettledWriterB', exitCode: 0 }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall(resume, ctx.context), undefined);
});

test('settled independent writer scopes remain resumable beside a non-conflicting reservation', async t => {
  const ctx = activeWriters(t, 'src-other/file.txt');
  ctx.fixture.state.envelope.writePaths.push('src-other/');
  writeFileSync(ctx.fixture.statePath, JSON.stringify(ctx.fixture.state));
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
  assert.equal(await ctx.gate.handleToolCall({ toolName: 'write', input: { path: 'agent://SettledWriterA', content: 'continue' } }, ctx.context), undefined);
});


test('resumed writer reservation blocks overlapping dispatch until the child settles again', async t => {
  const ctx = activeWriters(t);
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);
  const resume = { toolName: 'write', toolCallId: 'resume-a', input: { path: 'agent://SettledWriterA', content: 'continue' } };
  assert.equal(await ctx.gate.handleToolCall(resume, ctx.context), undefined);
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'running' }]);
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'idle' }]);
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
});

for (const status of ['idle', 'parked', 'aborted']) test(`resumed writer reservation releases when child becomes ${status}`, async t => {
  const ctx = activeWriters(t);
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall({
    toolName: 'write', toolCallId: 'resume-a',
    input: { path: 'agent://SettledWriterA', content: 'continue' },
  }, ctx.context), undefined);
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  if (status !== 'aborted') {
    ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'running' }]);
  }
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status }]);
  const unblockedEvent = { ...ctx.second, toolCallId: `call-b-unblocked-${status}` };
  assert.equal(await ctx.gate.handleToolCall(unblockedEvent, ctx.context), undefined);
});

test('settled writer scopes remain interlocked after more than 128 child events', async t => {
  const ctx = activeWriters(t);
  for (let index = 0; index < 130; index++) {
    const event = { ...ctx.first, toolCallId: `settled-call-${index}` };
    assert.equal(await ctx.gate.handleToolCall(event, ctx.context), undefined);
    ctx.gate.handleToolResult({ toolName: 'task', toolCallId: event.toolCallId, details: {
      results: [{ index: 0, id: `SettledWriter${index}`, exitCode: 0 }],
    } }, ctx.context);
  }
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
  const blocked = await ctx.gate.handleToolCall({
    toolName: 'write', input: { path: 'agent://SettledWriter0', content: 'resume oldest writer' },
  }, ctx.context);
  assert.equal(blocked?.block, true);
  assert.match(blocked.reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
});


test('resumed writer with pendingStart is not released on immediate idle before running', async t => {
  const ctx = activeWriters(t);
  const researchProbe = toolCallId => ({ ...ctx.second, toolCallId });
  const implementationProbe = toolCallId => ({ ...ctx.first, toolCallId });
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall({
    toolName: 'write', toolCallId: 'resume-a',
    input: { path: 'agent://SettledWriterA', content: 'continue' },
  }, ctx.context), undefined);
  assert.match((await ctx.gate.handleToolCall(researchProbe('probe-research-initial'), ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  // Child is still observed 'idle' right after write tool call
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'idle' }]);
  // Must NOT be released: overlapping dispatch must still be denied!
  assert.match((await ctx.gate.handleToolCall(implementationProbe('probe-implementation-after-idle'), ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  // Now child runs
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'running' }]);
  // Still active while running
  assert.match((await ctx.gate.handleToolCall(researchProbe('probe-research-running'), ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  // Child settles back to idle
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'idle' }]);
  // Now reservation releases and overlapping dispatch succeeds
  assert.equal(await ctx.gate.handleToolCall(implementationProbe('probe-implementation-after-settlement'), ctx.context), undefined);
});

test('resumed writer originally spawned by another agent releases on settlement (cross-owner)', async t => {
  const ctx = activeWriters(t);
  // Spawner is SubCoordinator, not Main
  const subCoordContext = { cwd: ctx.fixture.root, agent: { id: 'SubCoordinator' } };
  assert.equal(await ctx.gate.handleToolCall(ctx.first, subCoordContext), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'CrossOwnerWriter', exitCode: 0 }],
  } }, subCoordContext);
  // Main resumes CrossOwnerWriter
  assert.equal(await ctx.gate.handleToolCall({
    toolName: 'write', toolCallId: 'resume-cross',
    input: { path: 'agent://CrossOwnerWriter', content: 'continue from Main' },
  }, ctx.context), undefined);
  // Overlapping write from ctx.context (Main) is blocked
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  // Child transitions running, then idle with parentId: 'SubCoordinator'
  ctx.gate.onAgentRegistryChange([{ id: 'CrossOwnerWriter', parentId: 'SubCoordinator', status: 'running' }]);
  ctx.gate.onAgentRegistryChange([{ id: 'CrossOwnerWriter', parentId: 'SubCoordinator', status: 'idle' }]);
  // Reservation should release even though reservation.owner is Main because child.parentId matches scope.owner
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
});

test('errored write to agent:// releases reservation created by its invocation token', async t => {
  const ctx = activeWriters(t);
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall({
    toolName: 'write', toolCallId: 'resume-error',
    input: { path: 'agent://SettledWriterA', content: 'continue' },
  }, ctx.context), undefined);
  // Overlapping write blocked
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  // Write tool call failed with event.isError === true
  ctx.gate.handleToolResult({ toolName: 'write', toolCallId: 'resume-error', isError: true }, ctx.context);
  // Reservation should be released immediately
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
});

test('calling releaseObservedChildren with status idle immediately after resume does not release reservation', async t => {
  const ctx = activeWriters(t);
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall({
    toolName: 'write', toolCallId: 'resume-a',
    input: { path: 'agent://SettledWriterA', content: 'continue' },
  }, ctx.context), undefined);
  // Calling releaseObservedChildren with status: 'idle' immediately after resume DOES NOT release the reservation
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'idle' }]);
  // Overlapping dispatch remains denied
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
  // Child transitions to running (clears pendingStart)
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'running' }]);
  // Child settles back to idle
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'idle' }]);
  // Now overlapping dispatch is allowed
  const thirdEvent = {
    ...dispatchEvent(ctx.fixture, [{ name: 'WriterC', taskId: 'research01', agent: 'engineer', effects: { kind: 'write', paths: ['src/fixture.txt'] } }]),
    toolCallId: 'call-c',
  };
  assert.equal(await ctx.gate.handleToolCall(thirdEvent, ctx.context), undefined);
});


test('H1: already-running child at resume seeds pendingStart false and releases on subsequent idle', async t => {
  let registry = [];
  const ctx = activeWriters(t, 'src/fixture.txt', { getAgentRegistry: () => registry });
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);

  // Target child is already running in registry before resume
  registry = [{ id: 'SettledWriterA', parentId: 'Main', status: 'running' }];
  assert.equal(await ctx.gate.handleToolCall({
    toolName: 'write', toolCallId: 'resume-a',
    input: { path: 'agent://SettledWriterA', content: 'wake active child' },
  }, ctx.context), undefined);

  // Overlapping write is blocked while reservation is active
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);

  // Since the child was already running, a subsequent idle transition releases it.
  registry = [{ id: 'SettledWriterA', parentId: 'Main', status: 'idle' }];
  ctx.gate.onAgentRegistryChange(registry);
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
});

test('H2: aborted is terminal and releases reservation immediately even with pendingStart true', async t => {
  const ctx = activeWriters(t);
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);

  // Resume when child was not running -> pendingStart is true
  assert.equal(await ctx.gate.handleToolCall({
    toolName: 'write', toolCallId: 'resume-a',
    input: { path: 'agent://SettledWriterA', content: 'continue' },
  }, ctx.context), undefined);

  // Overlapping write is blocked
  assert.match((await ctx.gate.handleToolCall(ctx.second, ctx.context)).reason, /E_EFFECT_OUTSIDE_ENVELOPE/);

  // Child transitions to aborted before running; aborted MUST release immediately
  ctx.gate.onAgentRegistryChange([{ id: 'SettledWriterA', parentId: 'Main', status: 'aborted' }]);
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
});

test('H3: write to agent://<target>?progress does not reserve mutator', async t => {
  const ctx = activeWriters(t);
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'SettledWriterA', exitCode: 0 }],
  } }, ctx.context);

  // Write to agent://SettledWriterA?progress should NOT create a mutator reservation
  const progressWrite = {
    toolName: 'write',
    toolCallId: 'write-prog-1',
    input: { path: 'agent://SettledWriterA?progress', content: 'acknowledging task progress' },
  };
  assert.equal(await ctx.gate.handleToolCall(progressWrite, ctx.context), undefined);

  // ?progress does not wake an execution turn, so it must not block overlapping writers.
  assert.equal(await ctx.gate.handleToolCall(ctx.second, ctx.context), undefined);
});


test('C1 epoch guard prevents cross-lifecycle generation reuse', async t => {
  const ctx = activeWriters(t);
  assert.equal(await ctx.gate.handleToolCall(ctx.first, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'call-a', details: {
    results: [{ index: 0, id: 'EpochWriter', exitCode: 0 }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall({
    toolName: 'write', toolCallId: 'resume-before-revision',
    input: { path: 'agent://EpochWriter', content: 'continue' },
  }, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'old-generation-call', details: {
    results: [{ id: 'EpochWriter', exitCode: 0, generation: 1 }],
  } }, ctx.context);

  updateFixtureRevision(ctx.fixture, 'rev-2');
  const currentDispatch = {
    ...dispatchEvent(ctx.fixture, [{ name: 'WriterA', taskId: 'impl02', agent: 'engineer', effects: { kind: 'write', paths: ['src/'] } }]),
    toolCallId: 'current-call',
  };
  assert.equal(await ctx.gate.handleToolCall(currentDispatch, ctx.context), undefined);
  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'current-call', details: {
    results: [{ index: 0, id: 'EpochWriter', exitCode: 0 }],
  } }, ctx.context);
  assert.equal(await ctx.gate.handleToolCall({
    toolName: 'write', toolCallId: 'resume-current',
    input: { path: 'agent://EpochWriter', content: 'continue again' },
  }, ctx.context), undefined);

  ctx.gate.handleToolResult({ toolName: 'task', toolCallId: 'old-generation-call', details: {
    results: [{ id: 'EpochWriter', exitCode: 0 }],
  } }, ctx.context);
  const blocked = await ctx.gate.handleToolCall({
    ...dispatchEvent(ctx.fixture, [{ name: 'WriterB', taskId: 'research01', agent: 'engineer', effects: { kind: 'write', paths: ['src/fixture.txt'] } }]),
    toolCallId: 'current-overlap',
  }, ctx.context);
  assert.equal(blocked?.block, true);
  assert.match(blocked.reason, /E_EFFECT_OUTSIDE_ENVELOPE/);
});

test('C2 admission rejects revision drift during evaluation', async t => {
  const { promise: firstEvaluationStarted, resolve: signalFirst } = Promise.withResolvers();
  const { promise: firstEvaluationGate, resolve: releaseFirst } = Promise.withResolvers();
  let evaluationCount = 0;
  const ctx = activeWriters(t, 'src/fixture.txt', {
    evaluateDispatch: async (statePath, request) => {
      const report = evaluateDispatch(statePath, request);
      if (evaluationCount++ === 0) {
        signalFirst();
        await firstEvaluationGate;
      }
      return report;
    },
  });
  const firstDispatch = { ...ctx.first, toolCallId: 'stale-admission' };
  const pendingAdmission = ctx.gate.handleToolCall(firstDispatch, ctx.context);
  await firstEvaluationStarted;
  updateFixtureRevision(ctx.fixture, 'rev-2');

  const nextRevisionDispatch = {
    ...dispatchEvent(ctx.fixture, [{ name: 'WriterB', taskId: 'research01', agent: 'engineer', effects: { kind: 'write', paths: ['src/fixture.txt'] } }]),
    toolCallId: 'current-admission',
  };
  assert.equal(await ctx.gate.handleToolCall(nextRevisionDispatch, ctx.context), undefined);
  releaseFirst();
  const denied = await pendingAdmission;
  assert.equal(denied?.block, true);
  assert.match(denied.reason, /E_STATE_SOURCE/);
});
function pendingResearch(s) {
  s.authorization = null;
  s.reviews = null;
  s.tasks = s.tasks.map(task => task.id === 'research01' ? { ...task, status: 'pending', evidenceIds: [] } : task);
}

