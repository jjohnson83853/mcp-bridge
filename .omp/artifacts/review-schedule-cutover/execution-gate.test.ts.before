test('pause classification selects the latest aliased round among interleaved lineages', async t => {
  const ctx = stalledReviewContext(t);
  const repair = { id: 'FIX-2', path: 'src/fix.mjs', locator: 'line 9',
    requiredChange: 'Apply the exact repair.', withinEnvelope: true };
  const latestOwnerFinding = {
    ...reviewPauseRounds()[0].findings.at(-1),
    question: 'Latest aliased finding',
  };
  const history = [];
  for (let index = 0; index < 5; index++) {
    history.push({
      ...reviewPauseRounds()[index],
      seq: index * 2 + 1,
      lineageKey: 'prior-spec',
      candidateId: 'prior-spec',
      revision: `r${index + 1}`,
      findings: index === 4 ? [latestOwnerFinding] : [repair],
      priorFindings: [],
    });
    history.push({
      seq: index * 2 + 2,
      kind: 'round',
      lineageKey: 'other',
      candidateId: `other-r${index + 1}`,
      revision: `other-${index + 1}`,
      verdict: 'REVISE',
      findings: [repair],
      priorFindings: [],
    });
  }
  history.push({
    seq: 11, kind: 'alias', lineageKey: 'synthetic-spec',
    from: 'prior-spec', to: 'synthetic-spec', authorityRef: 'C2 fixture',
  });
  writeReviewHistory(ctx, history);

  const result = await ctx.call(ctx.event);
  assert.equal(result?.pause?.questions[0]?.question, 'Latest aliased finding');
});


