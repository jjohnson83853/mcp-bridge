const readEntry = { name: 'Research', taskId: 'research01', agent: 'scout', effects: { kind: 'read', paths: ['spec.md'] } };
const readonlyDiscovery = async () => ({ agents: [{ name: 'scout', tools: ['read', 'grep', 'glob', 'find'] }, { name: 'engineer', tools: ['read', 'write', 'edit'] }], searchedDirs: [] });
function setup(t, mutate, deps = {}, canonical = true) {
  const fixture = runtimeFixture(t, mutate, canonical);
  const logs = [];
  const gate = createToolCallGate({ evaluateDispatch, discoverAgents: readonlyDiscovery, log: entry => logs.push(entry), ...deps });
  return { fixture, logs, gate, call: event => gate.handleToolCall(event ?? dispatchEvent(fixture), { cwd: fixture.root }) };
}

function localGitTestDependencies() {
  const env = { ...process.env, GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: '/dev/null' };
  for (const key of ['GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE']) delete env[key];
  return {
    spawnSync(command, args, options) {
      return spawnSync(command, args, { ...options, env });
    },
  };
}

function initializeCleanLocalGitRepository(root, gitDependencies) {
  const git = (...args) => gitDependencies.spawnSync('git', args, { cwd: root, encoding: 'utf8' });
  const initialized = git('init', '--quiet');
  assert.equal(initialized.status, 0, initialized.stderr);
  const staged = git('add', '-A');
  assert.equal(staged.status, 0, staged.stderr);
  const committed = git('-c', 'user.name=Slice4 Test', '-c', 'user.email=slice4@example.invalid',
    '-c', 'commit.gpgsign=false', 'commit', '--quiet', '-m', 'fixture');
  assert.equal(committed.status, 0, committed.stderr);
}

function wrapper(event, change) {
  const body = JSON.parse(event.input.context);
  return { ...event, input: { ...event.input, context: JSON.stringify(change(body)) } };
}
function assertPayloadFailure(payload, code, field) {
  const result = gateApi.validateDispatchPayload(payload);
  assert.equal(result.ok, false);
  assert.equal(result.code, code);
  assert.equal(result.field, field);
  assert.equal(typeof result.detail, 'string');
  assert.ok(result.detail.length > 0);
  return result;
}
function plannerPayload(task, instructions = 'Design the interfaces without producing patches.') {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const body = JSON.parse(payload.context);
  body.workflowDispatch.requests[0].agent = 'planner';
  body.instructions = instructions;
  return {
    ...payload,
    context: JSON.stringify(body),
    tasks: [{ ...payload.tasks[0], agent: 'planner', task }],
  };
}

const CLI_PATH = fileURLToPath(new URL('./execution-state.mjs', import.meta.url));


const dispatchSeed = () => ({
  intent: 'Dispatch scoped task',
  instructions: 'Execute only the task below.',
  workflowDispatch: {
    statePath: '.omp/plans/execution-state.json',
    schemaVersion: 1,
    projectRoot: '/project',
    feature: 'sample-feature',
    revision: 'sample-r1',
    requests: [{ name: 'Research', taskId: 'research01', agent: 'scout', effects: { kind: 'read', paths: ['spec.md'] } }],
  },
  tasks: [{ name: 'Research', agent: 'scout', task: 'Read the scoped specification.', solutionSpace: 'Read-only fact retrieval.' }],
});

test('dispatch builder returns a stable native payload accepted by the runtime validator', () => {
  const seed = dispatchSeed();
  const first = gateApi.buildDispatchPayload(seed);
  assert.equal(first.ok, true);
  assert.deepEqual(gateApi.validateDispatchPayload(first.payload), { ok: true, shape: 'batch' });
  assert.deepEqual(gateApi.buildDispatchPayload(seed), first);
  assert.deepEqual(JSON.parse(first.payload.context), {
    instructions: seed.instructions,
    workflowDispatch: seed.workflowDispatch,
  });
});

test('dispatch validator reports safe field-specific failures before tool invocation', () => {
  const built = gateApi.buildDispatchPayload(dispatchSeed());
  assert.equal(built.ok, true);
  const payload = built.payload;
  const body = JSON.parse(payload.context);

  const missingInstructions = { ...body };
  delete missingInstructions.instructions;
  assert.equal(gateApi.validateDispatchPayload({ ...payload, context: JSON.stringify(missingInstructions) }).field, 'context.instructions');
  assert.equal(gateApi.validateDispatchPayload({ ...payload, context: `prefix ${payload.context}` }).field, 'context');
  assert.equal(gateApi.validateDispatchPayload({ ...payload, tasks: [{ ...payload.tasks[0], name: 'Wrong' }] }).field, 'tasks[].name');

  const invalidEffect = structuredClone(body);
  invalidEffect.workflowDispatch.requests[0].effects.kind = 'shell';
  assert.equal(
    gateApi.validateDispatchPayload({ ...payload, context: JSON.stringify(invalidEffect) }).field,
    'context.workflowDispatch.requests[0].effects.kind',
  );
});

test('dispatch payload rejects batches above three tasks with a typed concurrency denial', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const tooManyTasks = { ...payload, tasks: [...payload.tasks, ...payload.tasks, ...payload.tasks, ...payload.tasks] };
  assertPayloadFailure(tooManyTasks, 'E_CONCURRENCY_LIMIT', 'tasks.concurrency');
});

test('dispatch payload rejects tasks and wrapper instructions exceeding 32 KiB', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  assertPayloadFailure({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: 'x'.repeat(32_769) }],
  }, 'E_PAYLOAD_TOO_LARGE', 'task.size');
  assertPayloadFailure({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: `${'x'.repeat(32_769)}\n.omp/artifacts/payload.txt` }],
  }, 'E_PAYLOAD_TOO_LARGE', 'task.size');

  const wrapper = JSON.parse(payload.context);
  const tooLargeInstructions = { ...wrapper, instructions: 'x'.repeat(32_769) };
  assertPayloadFailure({
    ...payload,
    context: JSON.stringify(tooLargeInstructions),
  }, 'E_PAYLOAD_TOO_LARGE', 'context.instructions.size');
  assertPayloadFailure({
    ...payload.tasks[0],
    task: JSON.stringify(tooLargeInstructions),
  }, 'E_PAYLOAD_TOO_LARGE', 'context.instructions.size');
});

test('dispatch payload admits indented and fenced unified diffs in planner prompts', () => {
  for (const task of [
    'Design the contract.\n  --- a/src/old.ts\n  +++ b/src/new.ts\n  @@ -1,1 +1,1 @@',
    'Design the contract:\n```diff\n--- a/src/old.ts\n+++ b/src/new.ts\n@@ -1,1 +1,1 @@\n```',
  ]) {
    assert.equal(gateApi.validateDispatchPayload(plannerPayload(task)).ok, true);
  }
  assert.equal(gateApi.validateDispatchPayload(
    plannerPayload('Design the contract.', 'Review this patch:\n  ```diff\n  --- a/src/old.ts\n  +++ b/src/new.ts\n  ```'),
  ).ok, true);
});

test('dispatch payload admits prose formerly treated as raw telemetry', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const thirtyLines = Array.from({ length: 30 }, (_, index) => `stdout: line ${index}`).join('\n');
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: thirtyLines }],
  }).ok, true);

  const rawDump = Array.from({ length: 31 }, (_, index) => index % 3 === 0
    ? `stdout: line ${index}`
    : index % 3 === 1 ? `stderr= line ${index}` : `[stdout] line ${index}`).join('\n');
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: rawDump }],
  }).ok, true);
  for (const weakPointer of ['notes.md', 'reports/telemetry.log']) {
    assert.equal(gateApi.validateDispatchPayload({
      ...payload,
      tasks: [{ ...payload.tasks[0], task: `${rawDump}\nsee ${weakPointer}` }],
    }).ok, true);
  }
  for (const pointer of ['.omp/artifacts/telemetry.log', 'local://telemetry.log']) {
    assert.equal(gateApi.validateDispatchPayload({
      ...payload,
      tasks: [{ ...payload.tasks[0], task: `${rawDump}\n${pointer}` }],
    }).ok, true);
  }

  for (const task of ['x'.repeat(4_000), 'x'.repeat(4_001), `${'x'.repeat(4_001)}\nsummary`]) {
    assert.equal(gateApi.validateDispatchPayload({
      ...payload,
      tasks: [{ ...payload.tasks[0], task }],
    }).ok, true);
  }

  const wrapper = JSON.parse(payload.context);
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    context: JSON.stringify({ ...wrapper, instructions: rawDump }),
  }).ok, true);
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    context: JSON.stringify({ ...wrapper, instructions: `${rawDump}\nnotes.md` }),
  }).ok, true);
});

test('dispatch payload reports a non-JSON batch context as dispatch metadata', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const result = gateApi.validateDispatchPayload({
    ...payload,
    context: 'Raw dump follows.\nstdout: line 1\nstderr: line 2',
  });
  assert.equal(result.ok, false);
  assert.equal(result.code, 'E_DISPATCH_METADATA');
  assert.equal(result.field, 'context');
});

test('dispatch payload accepts a 35-line architectural Markdown task', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const task = Array.from({ length: 35 }, (_, index) =>
    `- **Decision ${index + 1}:** Keep the module boundary explicit and describe its contract in the design notes.`,
  ).join('\n');
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task }],
  }).ok, true);
  const longProse = Array.from({ length: 40 }, (_, index) =>
    `Design decision ${index + 1} preserves explicit component ownership, describes the public interface, names its caller, and explains the expected failure behavior.`,
  ).join(' ');
  assert.ok(longProse.length > 4_000);
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: longProse }],
  }).ok, true);
});

test('dispatch payload accepts comma-rich Markdown and CSV-looking prose', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const markdown = Array.from({ length: 35 }, (_, index) =>
    `- **Decision ${index + 1}:** Preserve ownership, describe the public interface, and document failure behavior.`,
  ).join('\n');
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: markdown }],
  }).ok, true);
  const headings = Array.from({ length: 35 }, (_, index) =>
    `### Decision ${index + 1}: Preserve ownership, describe the public interface, and document failure behavior.`,
  ).join('\n');
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: headings }],
  }).ok, true);

  const csv = Array.from({ length: 31 }, (_, index) => `${index},ERROR,worker`).join('\n');
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: csv }],
  }).ok, true);
  const compactCsv = Array.from({ length: 31 }, (_, index) => `${index},ERROR,worker,dispatch_denied`).join('\n');
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: compactCsv }],
  }).ok, true);
});

test('dispatch payload accepts repeated compact CSV rows', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const background = Array.from({ length: 30 }, (_, index) =>
    `Design note ${index + 1} describes the interface and failure behavior.`,
  ).join('\n');
  const oneCompactRow = `${background}\nalpha,beta,gamma,delta`;
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: oneCompactRow }],
  }).ok, true);

  const fiveRepeatedRows = `${background}\n${Array.from({ length: 5 }, () =>
    'alpha,beta,gamma,delta',
  ).join('\n')}`;
  assert.equal(gateApi.validateDispatchPayload({
    ...payload,
    tasks: [{ ...payload.tasks[0], task: fiveRepeatedRows }],
  }).ok, true);
});
test('dispatch payload accepts consecutive two-column table rows', () => {
  const payload = gateApi.buildDispatchPayload(dispatchSeed()).payload;
  const background = Array.from({ length: 30 }, (_, index) =>
    `Design note ${index + 1} describes the interface and failure behavior.`,
  ).join('\n');
  const formats = [
    ['CSV', 'alpha,beta'],
    ['TSV', 'alpha\tbeta'],
    ['aligned', 'alpha  beta'],
  ];

  for (const [format, row] of formats) {
    const validateRows = rows => gateApi.validateDispatchPayload({
      ...payload,
      tasks: [{ ...payload.tasks[0], task: `${background}\n${rows.join('\n')}` }],
    });
    assert.equal(validateRows(Array(4).fill(row)).ok, true, `${format}: four rows should pass`);
    assert.equal(validateRows(Array(5).fill(row)).ok, true, `${format}: five rows should pass`);
    assert.equal(
      validateRows(Array(5).fill(`- ${row}`)).ok,
      true,
      `${format}: Markdown list rows should be excluded`,
    );
    assert.equal(
      validateRows([row, row, 'A note separates the rows.', row, row, row]).ok,
      true,
      `${format}: separated rows should not count as consecutive`,
    );
  }
});

