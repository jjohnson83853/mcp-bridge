  ['nonobject report', () => undefined],
  ['unreadable status', report => ({ ...report, status: 'unreadable' })],
  ['empty reasons', report => ({ ...report, status: 'invalid', reasons: [] })],
  ['nonarray reasons', report => ({ ...report, status: 'invalid', reasons: { code: 'E_EVIDENCE_MISSING', location: 'gate.markerPath' } })],
]) test(`single-intake remediation: a malformed or unreadable legacy facade report stays E_STATE_SOURCE (${name})`, async t => {
