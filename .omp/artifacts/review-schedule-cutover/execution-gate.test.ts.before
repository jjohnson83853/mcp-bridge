test('pause lifecycle durably records opened, resumed and cleared observations without answer text', async t => {
  const ctx = stalledReviewContext(t);
  const opened = await ctx.call(ctx.event);
  assert.deepEqual(Object.keys(opened.pause).sort(), [
    'pauseId', 'kind', 'lineageKey', 'revision', 'classifier', 'context', 'questions', 'resume', 'excluded',
  ].sort());
  assert.deepEqual(Object.keys(opened.pause.questions[0]).sort(), ['id', 'question', 'evidence', 'answerKind', 'options'].sort());
  assert.deepEqual(opened.pause.questions[0].evidence, [{ path: 'spec.md', anchor: 'R1' }]);
  assert.equal(opened.pause.questions[0].answerKind, 'freeform');
  assert.deepEqual(opened.pause.questions[0].options, []);
  const pause = JSON.parse(readFileSync(ctx.fixture.statePath, 'utf8')).reviewPause;
  const answer = 'continue with one review round';
  const receipt = {
    pauseId: pause.pauseId,
    questionId: pause.questionIds[0],
    answer,
    answerDigest: sha(canonicalJson({
      pauseId: pause.pauseId, questionId: pause.questionIds[0], answer, packetDigest: pause.packetDigest,
    })),
  };
  assert.equal(opened.pause.pauseId, pause.pauseId);
  assert.equal(await ctx.call({ ...ctx.event, reviewPauseReceipt: receipt }), undefined);
  const state = JSON.parse(readFileSync(ctx.fixture.statePath, 'utf8'));
  const registry = JSON.parse(readFileSync(ctx.record.registryPath, 'utf8'));
  const expectedEvents = ['review_pause_opened', 'review_pause_resumed', 'review_pause_cleared'];
  assert.deepEqual(state.reviewPauseEvents.map(event => event.event), expectedEvents);
  assert.deepEqual(registry.reviewPauseEvents.map(event => event.event), expectedEvents);
  assert.equal(JSON.stringify(registry.reviewPauseEvents).includes(answer), false);
  const decisions = readFileSync(path.join(ctx.fixture.root, '.omp', 'plans', ctx.fixture.state.feature, 'decisions.md'), 'utf8');
  assert.match(decisions, /\[AUTO-DECISION\] review pause opened:/);
});
