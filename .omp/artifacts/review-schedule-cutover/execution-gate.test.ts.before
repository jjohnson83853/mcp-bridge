function retryReviewContext(t) {
  const ctx = setup(t, state => {
    Object.assign(state.tasks.find(task => task.id === 'research01'), {
      status: 'pending', evidenceIds: [], agentRoles: ['critic', 'code-reviewer'],
    });
  }, { discoverAgents: async () => ({
    agents: [{ name: 'critic', tools: ['read'] }, { name: 'code-reviewer', tools: ['read'] }], searchedDirs: [],
  }) });
  const entry = {
    name: 'Review', taskId: 'research01', agent: 'critic',
    effects: { kind: 'read', paths: ['spec.md'] },
    targetCandidateId: 'synthetic-spec', targetRevision: 'r2',
  };
  const event = dispatchEvent(ctx.fixture, [entry]);
  const unbound = {
    toolName: 'task',
    input: { context: 'Unmanaged review.', tasks: [{ ...event.input.tasks[0], targetRevision: ctx.fixture.state.revision }] },
  };
  const record = reviewSequenceFixture(ctx.fixture, [event, unbound]);
  return { ...ctx, event, entry, record };
}

function updateReviewTarget(ctx, targetRevision, workflowRevision = ctx.fixture.state.revision) {
  const { candidate } = ctx.record;
  candidate.revision = workflowRevision;
  candidate.codeReview.revision = workflowRevision;
  for (const dispatch of candidate.dispatches) {
    dispatch.targetCandidateId = candidate.id;
    dispatch.targetRevision = candidate.revision;
  }
  const body = JSON.parse(ctx.event.input.context);
  body.workflowDispatch.revision = workflowRevision;
  body.workflowDispatch.requests[0] = {
    ...ctx.entry, targetCandidateId: candidate.id, targetRevision,
  };
  ctx.event.input.context = JSON.stringify(body);
  ctx.event.input.tasks[0].targetCandidateId = candidate.id;
  ctx.event.input.tasks[0].targetRevision = targetRevision;
  const managed = candidate.dispatches.find(dispatch => dispatch.taskId === ctx.entry.taskId
    && dispatch.name === ctx.entry.name && dispatch.agent === ctx.entry.agent);
  managed.requestSha256 = sha(canonicalJson(body.workflowDispatch.requests[0]));
  ctx.record.observation.candidateId = candidate.id;
  ctx.record.observation.revision = candidate.revision;
  ctx.record.observation.dispatches = structuredClone(candidate.dispatches);
  const observation = JSON.stringify(ctx.record.observation);
  writeFileSync(ctx.record.sourcePath, observation);
  candidate.codeReview.source.sha256 = sha(observation);
  writeFileSync(ctx.record.registryPath, JSON.stringify(ctx.record.registry));
}

function addSyntheticOwnerAmendment(fixture, taskId) {
  const state = JSON.parse(readFileSync(fixture.statePath, 'utf8'));
  const task = state.tasks.find(item => item.id === taskId);
  const source = structuredClone(state.sources.find(item => item.kind === 'user-message'));
  source.id = 'synthetic-owner-amendment';
  source.locator = 'synthetic owner amendment signal';
  state.sources.push(source);
  state.decisions.push({
    id: 'synthetic-owner-amendment-decision',
    inputDigest: sha(canonicalJson({ taskId, effects: task.effects })),
    kind: 'owner', status: 'resolved', question: 'Confirm test amendment.',
    answer: 'Confirmed for this synthetic test.', rationale: 'explicit-owner-amendment',
    sourceIds: [source.id], affects: [taskId],
  });
  writeFileSync(fixture.statePath, JSON.stringify(state));
  return state;
}

test('targeted refusals retain retry accounting and only a new candidate revision opens a new key', async t => {
  const ctx = retryReviewContext(t);
  const first = await ctx.call(ctx.event);
  const second = await ctx.call(ctx.event);
  assert.match(first.reason, /E_REVIEW_TARGET/);
  assert.match(second.reason, /E_REVIEW_TARGET/);

  const amendedState = addSyntheticOwnerAmendment(ctx.fixture, ctx.entry.taskId);
  assert.notEqual(ownerAmendmentToken(amendedState, [ctx.entry.taskId]), null);
  updateReviewTarget(ctx, ctx.fixture.state.revision, ctx.fixture.state.revision);
  const correctedSameRevision = await ctx.call(ctx.event);
  assert.match(correctedSameRevision.reason, /E_RETRY_NOT_AUTHORIZED/);
  assert.doesNotMatch(correctedSameRevision.reason, /E_REVIEW_TARGET/);

  updateFixtureRevision(ctx.fixture, 'rev-2');
  updateReviewTarget(ctx, 'rev-2', 'rev-2');
  assert.equal(await ctx.call(ctx.event), undefined);
});
test('C1 persisted sequence keeps stall counters identical across an explicit alias rename', async t => {
  const ctx = stalledReviewContext(t);
  const ownerFinding = {
    id: 'C1-owner-decision', kind: 'owner-decision',
    question: 'Should the settled acceptance contract change?', evidence: [{ path: 'spec.md', anchor: 'R1' }],
  };
  const rounds = [
    { seq: 1, kind: 'round', lineageKey: 'x', candidateId: 'x-r9', revision: 'r9',
      verdict: 'PASS', findings: [ownerFinding], priorFindings: [] },
    { seq: 2, kind: 'round', lineageKey: 'x', candidateId: 'x-r1', revision: 'r1',
      verdict: 'REVISE', findings: [ownerFinding], priorFindings: [] },
    { seq: 3, kind: 'round', lineageKey: 'x', candidateId: 'x-r1', revision: 'r2',
      verdict: 'REVISE', findings: [ownerFinding], priorFindings: [] },
  ];
  const original = ctx.record.registry.candidates[0];
  rebindReviewCandidate(original, ctx.event, 'x-r1');
  original.codeReview = null;
  ctx.record.registry.reviewHistory = rounds;
  delete ctx.record.registry.reviewsHistory;
  writeFileSync(ctx.record.registryPath, JSON.stringify(ctx.record.registry));
  const before = reviewStallSignal(original, ctx.record.registry, rounds);

  const renamedRegistry = structuredClone(ctx.record.registry);
  const renamedCandidate = renamedRegistry.candidates[0];
  rebindReviewCandidate(renamedCandidate, ctx.event, 'renamed-r1');
  renamedCandidate.codeReview = null;
  renamedRegistry.reviewHistory = [
    ...rounds,
    { seq: 4, kind: 'alias', lineageKey: 'renamed', from: 'x', to: 'renamed', authorityRef: 'C1 fixture' },
  ];
  writeFileSync(ctx.record.registryPath, JSON.stringify(renamedRegistry));

  const result = await ctx.call(ctx.event);
  assert.equal(result?.code, 'E_REVIEW_PAUSE');
  const persisted = JSON.parse(readFileSync(ctx.record.registryPath, 'utf8'));
  assert.deepEqual(
    [persisted.candidates[0].nonPassStreak, persisted.candidates[0].noProgressCount],
    [before.nonPassStreak, before.noProgressCount],
  );
  assert.deepEqual([before.nonPassStreak, before.noProgressCount], [2, 2]);
});

test('C3 refuses a stale registry commit and preserves the concurrent append', async t => {
  const ctx = stalledReviewContext(t);
  const registryPath = ctx.record.registryPath;
  let appended = false;
  const gate = createToolCallGate({
    evaluateDispatch, discoverAgents: criticDiscovery, log: () => {},
    readFileSync(file, encoding) {
      if (file === registryPath && encoding === undefined && !appended) {
        const registry = JSON.parse(readFileSync(file, 'utf8'));
        registry.reviewHistory = [
          ...(registry.reviewHistory ?? []),
          { seq: 6, kind: 'round', lineageKey: 'synthetic-spec',
            candidateId: 'synthetic-spec-r6', revision: 'r6', verdict: 'REVISE', findings: [] },
        ];
        writeFileSync(file, JSON.stringify(registry));
        appended = true;
      }
      return encoding === undefined ? readFileSync(file) : readFileSync(file, encoding);
    },
  });

  const result = await gate.handleToolCall(ctx.event, { cwd: ctx.fixture.root });
  assert.equal(appended, true);
  assert.match(result?.reason ?? '', /E_REVIEW_REGISTRY_CHANGED/);
  const persisted = JSON.parse(readFileSync(registryPath, 'utf8'));
  assert.equal(persisted.reviewHistory.at(-1).candidateId, 'synthetic-spec-r6');
  assert.equal(Object.hasOwn(JSON.parse(readFileSync(ctx.fixture.statePath, 'utf8')), 'reviewPause'), false);
});
test('AC01-1 registry pause lock refuses an in-window producer then preserves its post-release append', async t => {
  const ctx = stalledReviewContext(t);
  const registryPath = ctx.record.registryPath;
  ctx.record.candidate.dispatches.push({
    name: 'ProducerReview', agent: 'code-reviewer', reviewerId: 'synthetic-producer-code-reviewer',
  });
  ctx.record.candidate.codeReview = null;
  writeFileSync(registryPath, JSON.stringify(ctx.record.registry));

  let inWindow;
  let registryRenames = 0;
  let registryTempWrites = 0;
  const io = {
    readFileSync(file, encoding) {
      if (file === registryPath && encoding === undefined && !inWindow) {
        const compareBytes = readFileSync(file);
        const stateBefore = readFileSync(ctx.fixture.statePath);
        const registryBefore = JSON.parse(compareBytes.toString('utf8'));
        const countBefore = reviewSequence.reviewRoundCount(registryBefore, 'synthetic-spec');
        const pauseBytesBefore = pauseRecordBytes(registryBefore);
        const renameCountBefore = registryRenames;
        const tempCountBefore = registryTempWrites;
        const producerAttempt = persistSyntheticReviewRound(registryPath, io);
        const registryAfter = readFileSync(registryPath);
        const stateAfter = readFileSync(ctx.fixture.statePath);
        const persistedAfter = JSON.parse(registryAfter.toString('utf8'));
        inWindow = {
          producerAttempt,
          registryUnchanged: registryAfter.equals(compareBytes),
          stateUnchanged: stateAfter.equals(stateBefore),
          pauseBytesUnchanged: pauseRecordBytes(persistedAfter) === pauseBytesBefore,
          roundCountUnchanged: reviewSequence.reviewRoundCount(persistedAfter, 'synthetic-spec') === countBefore,
          noRegistryRename: registryRenames === renameCountBefore,
          noTemporaryWrite: registryTempWrites === tempCountBefore,
        };
        return compareBytes;
      }
      return encoding === undefined ? readFileSync(file) : readFileSync(file, encoding);
    },
    writeFileSync(file, ...args) {
      if (typeof file === 'string' && file.startsWith(`${registryPath}.`) && file.endsWith('.tmp')) {
        registryTempWrites++;
      }
      return writeFileSync(file, ...args);
    },
    renameSync(from, to) {
      if (to === registryPath) registryRenames++;
      return renameSync(from, to);
    },
  };
  const gate = createToolCallGate({
    evaluateDispatch, discoverAgents: criticDiscovery, log: () => {}, ...io,
  });
  const result = await gate.handleToolCall(ctx.event, { cwd: ctx.fixture.root });

  assert.ok(inWindow, 'the compare-to-rename hook ran');
  assert.deepEqual(inWindow.producerAttempt, {
    ok: false, code: 'E_REVIEW_REGISTRY_CHANGED', lockCode: 'E_LOCK_REENTRANT',
  });
  for (const key of ['registryUnchanged', 'stateUnchanged', 'pauseBytesUnchanged',
    'roundCountUnchanged', 'noRegistryRename', 'noTemporaryWrite']) assert.equal(inWindow[key], true, key);
  assert.equal(result?.code, 'E_REVIEW_PAUSE');

  const state = JSON.parse(readFileSync(ctx.fixture.statePath, 'utf8'));
  const afterPause = JSON.parse(readFileSync(registryPath, 'utf8'));
  assert.ok(state.reviewPause);
  assert.equal(afterPause.reviewPauseHistory.length, 1);
  const lockedSignal = reviewStallSignal(afterPause.candidates[0], afterPause, afterPause.reviewsHistory);
  assert.deepEqual(
    [result.pause.context.nonPassStreak, result.pause.context.noProgressCount,
      afterPause.candidates[0].nonPassStreak, afterPause.candidates[0].noProgressCount],
    [lockedSignal.nonPassStreak, lockedSignal.noProgressCount, lockedSignal.nonPassStreak, lockedSignal.noProgressCount],
  );

  const roundsBefore = reviewSequence.reviewRoundCount(afterPause, 'synthetic-spec');
  const producerCommit = persistSyntheticReviewRound(registryPath);
  assert.equal(producerCommit.ok, true);
  const afterProducer = JSON.parse(readFileSync(registryPath, 'utf8'));
  assert.equal(reviewSequence.reviewRoundCount(afterProducer, 'synthetic-spec'), roundsBefore + 1);
  assert.ok(reviewSequence.lineageReviewHistory(afterProducer, 'synthetic-spec').rounds
    .some(round => round.seq === producerCommit.entry.seq));
  assert.equal(afterProducer.reviewPauseHistory.length, 1);
  assert.equal(afterProducer.candidates[0].pauses.length, 1);
  assert.equal(JSON.parse(readFileSync(ctx.fixture.statePath, 'utf8')).reviewPause.pauseId,
    afterProducer.reviewPauseHistory[0].pauseId);
});

test('SR4-2 locked reclassification aborts an obsolete pause without consuming a slot', async t => {
  const ctx = stalledReviewContext(t);
  const registryPath = ctx.record.registryPath;
  let interleaved = false;
  let interleavedRegistryBytes;
  let interleavedSignal;
  const registryLockPaths = [];
  const gate = createToolCallGate({
    evaluateDispatch, discoverAgents: criticDiscovery, log: () => {},
    openSync(file, ...args) {
      registryLockPaths.push(file);
      if (file === `${path.resolve(registryPath)}.lock` && !interleaved) {
        interleaved = true;
        const registry = JSON.parse(readFileSync(registryPath, 'utf8'));
        const exactRepair = {
          id: 'SR4-2-resolved-owner-item', path: 'src/fix.mjs', locator: 'line 9',
          requiredChange: 'Apply the completed technical repair.', withinEnvelope: true,
        };
        registry.reviewsHistory = reviewPauseRounds().map((review, index) => index === 4
          ? { ...review, findings: [exactRepair], priorFindings: [] } : review);
        interleavedRegistryBytes = Buffer.from(JSON.stringify(registry));
        writeFileSync(registryPath, interleavedRegistryBytes);
        interleavedSignal = reviewStallSignal(registry.candidates[0], registry, registry.reviewsHistory);
      }
      return openSync(file, ...args);
    },
  });

  const result = await gate.handleToolCall(ctx.event, { cwd: ctx.fixture.root });
  assert.equal(interleaved, true);
  assert.deepEqual(registryLockPaths, [`${path.resolve(registryPath)}.lock`], 'only the review registry lock should be opened');
  assert.equal(interleavedSignal.stalled, true);
  assert.equal(reviewSequence.classifyReviewFindings(
    JSON.parse(interleavedRegistryBytes.toString('utf8')).reviewsHistory.at(-1).findings, [],
  ).ownerDecision.length, 0);
  assert.match(result?.reason ?? '', /E_REVIEW:/);
  assert.doesNotMatch(result?.reason ?? '', /E_REVIEW_PAUSE/);

  const state = JSON.parse(readFileSync(ctx.fixture.statePath, 'utf8'));
  const registryBytes = readFileSync(registryPath);
  const registry = JSON.parse(registryBytes.toString('utf8'));
  assert.equal(Object.hasOwn(state, 'reviewPause'), false);
  assert.equal(registryBytes.equals(interleavedRegistryBytes), true);
  assert.equal(registry.reviewPauseHistory?.length ?? 0, 0);
  assert.equal(registry.reviewPauseEvents?.length ?? 0, 0);
  assert.equal(registry.candidates[0].pauses?.length ?? 0, 0);
  assert.equal(Object.hasOwn(registry.candidates[0], 'nonPassStreak'), false);
});


test('C4 conflicting candidate and registry verdicts fail closed', async t => {
  const ctx = stalledReviewContext(t);
  const registry = ctx.record.registry;
  const candidate = registry.candidates[0];
  candidate.reviewsHistory = reviewPauseRounds().slice(0, 3);
  const conflicting = {
    ...candidate.reviewsHistory[1], seq: 1, verdict: 'PASS',
  };
  delete registry.reviewsHistory;
  registry.reviewHistory = [conflicting];
  writeFileSync(ctx.record.registryPath, JSON.stringify(registry));

  const result = await ctx.call(ctx.event);
  assert.match(result?.reason ?? '', /E_REVIEW:/);
  assert.doesNotMatch(result?.reason ?? '', /E_REVIEW_PAUSE/);
  assert.equal(Object.hasOwn(JSON.parse(readFileSync(ctx.fixture.statePath, 'utf8')), 'reviewPause'), false);
});

test('C4 an empty candidate history cannot mask registry lineage history', async t => {
  const ctx = stalledReviewContext(t);
  const registry = writeReviewHistory(ctx, reviewPauseRounds().slice(0, 3));
  registry.candidates[0].reviewsHistory = [];
  writeFileSync(ctx.record.registryPath, JSON.stringify(registry));

  const result = await ctx.call(ctx.event);
  assert.equal(result?.code, 'E_REVIEW_PAUSE');
  const persisted = JSON.parse(readFileSync(ctx.record.registryPath, 'utf8'));
  assert.deepEqual(
    [persisted.candidates[0].nonPassStreak, persisted.candidates[0].noProgressCount],
    [3, 2],
  );
});

test('C4 newest sequence supplies the merged round findings', async t => {
  const ctx = stalledReviewContext(t);
  const candidateHistory = reviewPauseRounds().slice(0, 3).map((review, index) => ({
    ...review, candidateId: `synthetic-spec-r${index + 3}`, revision: `r${index + 3}`,
  }));
  const latest = {
    ...candidateHistory[2], seq: 6,
    findings: [{
      ...candidateHistory[2].findings.at(-1),
      question: 'Newest registry round finding',
    }],
  };
  const registry = ctx.record.registry;
  registry.candidates[0].reviewsHistory = candidateHistory;
  delete registry.reviewsHistory;
  registry.reviewHistory = [
    { ...candidateHistory[0], seq: 4 },
    { ...candidateHistory[1], seq: 5 },
    latest,
  ];
  writeFileSync(ctx.record.registryPath, JSON.stringify(registry));

  const result = await ctx.call(ctx.event);
  assert.equal(result?.pause?.questions[0]?.question, 'Newest registry round finding');
});