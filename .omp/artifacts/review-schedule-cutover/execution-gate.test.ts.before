// --- single-intake remediation: shared producer/consumer authority contract ---
const engineerWrite = [{ name: 'Implement', taskId: 'impl02', agent: 'engineer', effects: { kind: 'write', paths: ['src/'] } }];
const researchRead = agent => [{
  name: 'Research', taskId: 'research01', agent, effects: { kind: 'read', paths: ['spec.md'] },
  ...(['critic', 'code-reviewer'].includes(agent)
    ? { targetCandidateId: 'synthetic-spec', targetRevision: 'rev-1' }
    : {}),
}];
const notReadyAuthority = [
  ['nested specification review null', s => { s.reviews.specification = null; }],
  ['nested tasks review null', s => { s.reviews.tasks = null; }],
  ['nonexplicit owner receipt', s => { s.authorization.receipt.response.explicit = false; }],
  ['automatic owner receipt', s => { s.authorization.receipt.response.automatic = true; }],
  ['timed out owner receipt', s => { s.authorization.receipt.response.timedOut = true; }],
];
const pendingResearchGrant = agentRoles => s => {
  s.tasks = s.tasks.map(task => task.id === 'research01' ? { ...task, status: 'pending', evidenceIds: [], agentRoles } : task);
};
const criticDiscovery = async () => ({ agents: [{ name: 'critic', tools: ['read'], spawns: [] }], searchedDirs: [] });
function gateRequest(fixture, statePath, entries) {
  return { schemaVersion: 1, projectRoot: fixture.root, feature: fixture.state.feature, revision: fixture.state.revision, requests: entries };
}
function assertSharedAllowed(fixture, statePath, entries, label) {
  const payload = dispatchEvent(fixture, entries).input;
  const report = evaluateDispatch(statePath, gateRequest(fixture, statePath, entries), { reviewPayload: payload });
  assert.notEqual(report.status, 'invalid', label);
  assert.equal(report.allowed, true, label);
}
function copyState(fixture, relative) {
  const target = path.join(fixture.root, relative);
  mkdirSync(path.dirname(target), { recursive: true });
  writeFileSync(target, readFileSync(fixture.statePath));
  return target;
}
function moveState(fixture, relative) {
  const target = copyState(fixture, relative);
  rmSync(fixture.statePath);
  return target;
}
function atState(event, statePath) {
  const body = JSON.parse(event.input.context);
  return { ...event, input: { ...event.input, context: JSON.stringify({ ...body, workflowDispatch: { ...body.workflowDispatch, statePath } }) } };
}

// D2: while authority is not ready (binding pending inside non-null top-level
// fields), only effective read-only roles may run research reads; the
// engineer-granted pending research read must fail closed.
for (const [name, mutate] of notReadyAuthority) test(`single-intake remediation: not-ready authority denies the engineer-granted pending research read (${name})`, async t => {
  const ctx = setup(t, s => {
    mutate(s);
    pendingResearchGrant(['engineer'])(s);
  });
  const entry = researchRead('engineer');
  assertSharedAllowed(ctx.fixture, ctx.fixture.statePath, entry, name);
  const result = await ctx.call(dispatchEvent(ctx.fixture, entry));
  assert.equal(result?.block, true, name);
  assert.match(result.reason, /E_READONLY_NOT_EXEMPT/, name);
});

for (const [name, mutate] of notReadyAuthority) test(`single-intake remediation: not-ready authority allows the effective read-only critic research read (${name})`, async t => {
  const ctx = setup(t, s => {
    mutate(s);
    pendingResearchGrant(['critic'])(s);
  }, { discoverAgents: criticDiscovery });
  const entry = researchRead('critic');
  reviewSequenceFixture(ctx.fixture, [dispatchEvent(ctx.fixture, entry)]);
  assertSharedAllowed(ctx.fixture, ctx.fixture.statePath, entry, name);
  assert.equal(await ctx.call(dispatchEvent(ctx.fixture, entry)), undefined, name);
});

