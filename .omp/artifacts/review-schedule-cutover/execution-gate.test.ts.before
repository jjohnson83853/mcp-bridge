  const before = files.map(file => existsSync(file) ? readFileSync(file, 'utf8') : null);
  const gate = createToolCallGate({
    evaluateDispatch: () => ({ allowed: false, authority_ready: true, reasons: [{ code: 'E_REVIEW' }] }),
    discoverAgents: criticDiscovery,
    log: () => {},
  });
