// D4: an invalid legacy facade report is a typed historical-marker denial, never a
// usable source. Only the exact marker-only fault (every reason E_EVIDENCE_MISSING
// at gate.markerPath) beside a recognized non-read effect may deny E_PROJECT_GATE;
// every other invalid/unreadable/malformed report stays E_STATE_SOURCE. After either
// denial no sidecar content is read, no dispatch is evaluated, and no source sticks
// as the active identity.
function trackedDeps(facadeFault) {
  const calls = { dispatch: 0, facade: 0, reads: [] };
  const deps = {
    evaluateDispatch: (statePath, request) => { calls.dispatch += 1; return evaluateDispatch(statePath, request); },
    readFileSync: (file, options) => { calls.reads.push(String(file)); return readFileSync(file, options); },
    evaluateState: (statePath, inner) => {
      calls.facade += 1;
      const report = evaluateState(statePath, inner);
      return facadeFault ? facadeFault(report) : report;
    },
  };
  return { calls, deps };
}
const legacyMarkerPath = root => path.join(root, '.superpowers', 'sdd', 'GATE_OPEN');
const legacyCurrentPath = root => path.join(root, '.omp', 'plans', 'execution-state.json');
function legacySidecarContext(t, deps, mutate = undefined) {
  const ctx = setup(t, mutate, deps);
  const sidecar = moveState(ctx.fixture, path.join('.omp', 'plans', ctx.fixture.state.feature, 'execution-state.json'));
  legacyState(ctx.fixture.root);
  return { ctx, sidecar };
}

test('single-intake remediation: a marker-only invalid legacy report denies a recognized write as E_PROJECT_GATE without reading the sidecar or dispatching', async t => {
  const { calls, deps } = trackedDeps();
  const { ctx, sidecar } = legacySidecarContext(t, deps);
  rmSync(legacyMarkerPath(ctx.fixture.root));
  const facade = evaluateState(legacyCurrentPath(ctx.fixture.root));
  assert.equal(facade.status, 'invalid');
  assert.equal(facade.reasons.length, 1);
  assert.equal(facade.reasons[0].code, 'E_EVIDENCE_MISSING');
  assert.equal(facade.reasons[0].location, 'gate.markerPath');
  const result = await ctx.call(atState(dispatchEvent(ctx.fixture), sidecar));
  assert.equal(result?.block, true);
  assert.match(result.reason, /E_PROJECT_GATE/);
  assert.equal(calls.dispatch, 0);
  assert.equal(calls.reads.includes(sidecar), false);
});

test('single-intake remediation: mixed marker and receipt faults keep the schema-2 sidecar denied as E_STATE_SOURCE', async t => {
  const { calls, deps } = trackedDeps();
  const { ctx, sidecar } = legacySidecarContext(t, deps);
  rmSync(legacyMarkerPath(ctx.fixture.root));
  rmSync(path.join(ctx.fixture.root, '.superpowers', 'sdd', 'receipt'));
  const facade = evaluateState(legacyCurrentPath(ctx.fixture.root));
  assert.equal(facade.status, 'invalid');
  assert.ok(facade.reasons.length > 1);
  assert.ok(facade.reasons.some(reason => reason.location !== 'gate.markerPath'));
  const result = await ctx.call(atState(dispatchEvent(ctx.fixture), sidecar));
  assert.equal(result?.block, true);
  assert.match(result.reason, /E_STATE_SOURCE/);
  assert.doesNotMatch(result.reason, /E_PROJECT_GATE/);
  assert.equal(calls.dispatch, 0);
  assert.equal(calls.reads.includes(sidecar), false);
});

