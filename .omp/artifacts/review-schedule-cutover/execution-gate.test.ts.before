  assert.doesNotMatch(result.reason, /E_PROJECT_GATE/);
  assert.equal(calls.dispatch, 0);
  assert.equal(calls.reads.includes(sidecar), false);
});

test('single-intake remediation: arbitrary thrown facade errors are never trusted as typed denials', async t => {
  const { calls, deps } = trackedDeps(() => { throw Object.assign(Error('SECRET_CANARY'), { code: 'E_PROJECT_GATE' }); });
  const { ctx, sidecar } = legacySidecarContext(t, deps);
  assert.equal(evaluateState(legacyCurrentPath(ctx.fixture.root)).status, 'ready');
  const first = await ctx.call(atState(dispatchEvent(ctx.fixture), sidecar));
  assert.equal(first?.block, true);
  assert.match(first.reason, /E_STATE_SOURCE/);
  assert.doesNotMatch(first.reason, /E_PROJECT_GATE/);
  assert.equal(JSON.stringify(first).includes('SECRET_CANARY'), false);
  const second = await ctx.call(atState(dispatchEvent(ctx.fixture), sidecar));
  assert.equal(second?.block, true);
  assert.match(second.reason, /E_STATE_SOURCE/);
  assert.doesNotMatch(second.reason, /E_PROJECT_GATE/);
  assert.equal(calls.dispatch, 0);
  assert.equal(calls.reads.includes(sidecar), false);
});

