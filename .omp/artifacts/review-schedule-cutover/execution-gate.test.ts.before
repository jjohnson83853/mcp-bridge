function legacyState(root, marker = true) {
  const base = path.join(root, '.omp/plans');
  const evidence = path.join(root, '.superpowers/sdd');
  mkdirSync(base, { recursive: true });
  mkdirSync(evidence, { recursive: true });
  const feature = 'reconciliation';
  const revision = 'r-old';
  const receipt = { revision, evidence: path.join(evidence, 'receipt') };
  const state = { schemaVersion: 1, feature, revision, approvals: { requirements: receipt, design: receipt, tasks: receipt }, reviews: { specification: receipt, tasks: receipt }, tasks: [{ id: 'OLD', stage: 'implementation', status: 'pending', blockedBy: [], requires: [] }], availableCapabilities: [], blockers: [], gate: { feature, revision, markerPath: path.join(evidence, 'GATE_OPEN'), extensionPath: path.join(evidence, 'extension'), loadEvidencePath: path.join(evidence, 'loaded') } };
  const checkpointRevisions = Object.fromEntries(['approvals.requirements', 'approvals.design', 'approvals.tasks', 'reviews.specification', 'reviews.tasks'].map(key => [key, revision]));
  for (const file of ['receipt', 'extension', 'loaded', ...(marker ? ['GATE_OPEN'] : [])]) writeFileSync(path.join(evidence, file), `${feature} ${revision} SYNTHETIC TEST DATA`);
  writeFileSync(path.join(base, 'execution-state.json'), JSON.stringify({ ...state, checkpointRevisions }));
}

