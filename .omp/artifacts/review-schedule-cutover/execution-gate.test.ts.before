const reviewPauseRounds = () => Array.from({ length: 5 }, (_, index) => {
  const revision = index + 3;
  const carried = [
    { id: 'ADV-B', status: 'OPEN', severity: 'blocking', evidenceClass: 'correctness', anchor: 'src/a.mjs:12' },
    { id: 'ADV-H', status: 'OPEN', severity: 'blocking', evidenceClass: 'security', anchor: 'src/b.mjs:8' },
  ];
  const ownerFinding = {
    id: 'D-1-conflict', decisionId: 'd-1', kind: 'owner-decision',
    question: 'Should the settled acceptance contract change?', evidence: [{ path: 'spec.md', anchor: 'R1' }],
  };
  return {
    seq: index + 1,
    kind: 'round',
    lineageKey: 'synthetic-spec',
    candidateId: `synthetic-spec-r${revision}`,
    revision: `r${revision}`,
    verdict: 'REVISE',
    inputHashes: { spec: `hash-${revision}` },
    findings: [...carried, ownerFinding],
    priorFindings: structuredClone(carried),
  };
});

function rebindReviewCandidate(candidate, event, candidateId) {
  candidate.id = candidateId;
  const wrapper = JSON.parse(event.input.context);
  const request = wrapper.workflowDispatch.requests[0];
  request.targetCandidateId = candidateId;
  for (const item of event.input.tasks ?? [event.input]) item.targetCandidateId = candidateId;
  event.input.context = JSON.stringify(wrapper);
  for (const dispatch of candidate.dispatches) {
    dispatch.targetCandidateId = candidateId;
    if (dispatch.taskId === request.taskId && dispatch.name === request.name && dispatch.agent === request.agent) {
      dispatch.requestSha256 = sha(canonicalJson(request));
    }
  }
}

function stalledReviewContext(t) {
  const ctx = setup(t, state => {
    state.tasks[0] = { ...state.tasks[0], status: 'pending', evidenceIds: [], agentRoles: ['critic', 'code-reviewer'] };
  }, { discoverAgents: async () => ({
    agents: [{ name: 'critic', tools: ['read'] }, { name: 'code-reviewer', tools: ['read'] }], searchedDirs: [],
  }) });
  const entry = { name: 'Review', taskId: 'research01', agent: 'critic', effects: { kind: 'read', paths: ['spec.md'] } };
  const event = dispatchEvent(ctx.fixture, [entry]);
  const record = reviewSequenceFixture(ctx.fixture, [event]);
  record.candidate.codeReview.verdict = 'REVISE';
  record.registry.reviewsHistory = reviewPauseRounds();
  writeFileSync(record.registryPath, JSON.stringify(record.registry));
  return { ...ctx, event, record };
}
function persistSyntheticReviewRound(registryPath, dependencies = {}) {
  const io = {
    readFileSync: dependencies.readFileSync ?? readFileSync,
    writeFileSync: dependencies.writeFileSync ?? writeFileSync,
    renameSync: dependencies.renameSync ?? renameSync,
  };
  return reviewSequence.withReviewRegistryLock(registryPath, {}, dependencies, () => {
    const registry = JSON.parse(io.readFileSync(registryPath, 'utf8'));
    const candidate = registry.candidates.find(item => item?.id === 'synthetic-spec');
    const reviewer = candidate?.dispatches?.find(dispatch => dispatch.agent === 'code-reviewer');
    if (!candidate || !reviewer) throw Error('synthetic producer candidate is unavailable');
    const appended = reviewSequence.bindWithReviewRound(registry, {
      candidateId: candidate.id,
      reviewerId: reviewer.reviewerId,
      authorIds: structuredClone(candidate.authorIds),
      inputs: structuredClone(candidate.inputs),
      dispatches: structuredClone(candidate.dispatches),
      verdict: 'REQUEST CHANGES',
      findings: [],
      format: 'installed',
      source: { path: 'synthetic-producer-review.json', sha256: 'e'.repeat(64) },
      recordedAt: '2026-11-14T12:01:00.000Z',
    });
    if (!appended.ok) return appended;
    const temporary = `${registryPath}.producer.tmp`;
    io.writeFileSync(temporary, `${JSON.stringify(appended.registry)}\n`, { flag: 'wx', mode: 0o600 });
    io.renameSync(temporary, registryPath);
    return appended;
  });
}

function pauseRecordBytes(registry) {
  return JSON.stringify({
    reviewPauseHistory: registry.reviewPauseHistory ?? [],
    reviewPauseEvents: registry.reviewPauseEvents ?? [],
    candidates: registry.candidates.map(candidate => ({
      pauses: candidate.pauses ?? [],
      nonPassStreak: candidate.nonPassStreak ?? null,
      noProgressCount: candidate.noProgressCount ?? null,
    })),
  });
}

function writeReviewHistory(ctx, reviewHistory) {
  const registry = JSON.parse(readFileSync(ctx.record.registryPath, 'utf8'));
  delete registry.reviewsHistory;
  registry.reviewHistory = reviewHistory;
  writeFileSync(ctx.record.registryPath, JSON.stringify(registry));
  return registry;
}

test('AC01-7 gate fallback preserves stall counters and pause cap after serialized alias rename', async t => {
  const ctx = stalledReviewContext(t);
  const before = reviewStallSignal(ctx.record.candidate, ctx.record.registry, reviewPauseRounds());
  assert.deepEqual([before.nonPassStreak, before.noProgressCount], [5, 4]);

  const registry = JSON.parse(JSON.stringify(ctx.record.registry));
  const candidate = registry.candidates[0];
  const oldLineage = candidate.id.replace(/-r\d+$/, '') || candidate.id;
  rebindReviewCandidate(candidate, ctx.event, 'renamed-spec');
  candidate.codeReview = null;
  registry.reviewHistory = [
    ...reviewPauseRounds(),
    { seq: 6, kind: 'alias', lineageKey: 'renamed-spec', from: oldLineage, to: 'renamed-spec', authorityRef: 'AC01-7 fixture' },
  ];
  delete registry.reviewsHistory;
  registry.reviewPauseHistory = [
    { lineageKey: oldLineage, pauseId: 'old-1', status: 'resumed' },
    { lineageKey: 'renamed-spec', pauseId: 'old-2', status: 'resumed' },
  ];
  writeFileSync(ctx.record.registryPath, JSON.stringify(registry));

  const result = await ctx.call(ctx.event);
  assert.equal(result?.code, 'E_REVIEW_PAUSE');
  assert.deepEqual(result.blocked, {
    kind: 'review_pause_cap', lineageKey: 'renamed-spec', pauseCount: 2, cap: 2,
  });
  const persisted = JSON.parse(readFileSync(ctx.record.registryPath, 'utf8'));
  assert.deepEqual(persisted.reviewHistory.map(({ seq, kind }) => [seq, kind]), [
    [1, 'round'], [2, 'round'], [3, 'round'], [4, 'round'], [5, 'round'], [6, 'alias'],
  ]);
  assert.deepEqual(
    [persisted.candidates[0].nonPassStreak, persisted.candidates[0].noProgressCount],
    [before.nonPassStreak, before.noProgressCount],
  );
});
test('malformed immutable review history denies admission without opening a pause', async t => {
  const ctx = stalledReviewContext(t);
  writeReviewHistory(ctx, [
    { ...reviewPauseRounds()[0], seq: 2 },
    { ...reviewPauseRounds()[1], seq: 1 },
    ...reviewPauseRounds().slice(2),
  ]);

  const result = await ctx.call(ctx.event);
  assert.match(result?.reason ?? '', /E_REVIEW:/);
  assert.doesNotMatch(result?.reason ?? '', /E_REVIEW_PAUSE/);
  assert.equal(Object.hasOwn(JSON.parse(readFileSync(ctx.fixture.statePath, 'utf8')), 'reviewPause'), false);
});
test('review fallback ignores failed transport records instead of reopening the substantive-review frontier', async t => {
  const ctx = stalledReviewContext(t);
  const registry = JSON.parse(readFileSync(ctx.record.registryPath, 'utf8'));
  const candidate = registry.candidates[0];
  candidate.codeReview = null;
  delete candidate.reviewsHistory;
  delete candidate.reviewHistory;
  delete registry.reviewsHistory;
  registry.reviewHistory = [];
  writeFileSync(ctx.record.registryPath, JSON.stringify(registry));
  writeFileSync(path.join(ctx.fixture.root, '.omp/plans/review-runs.json'), JSON.stringify({
    schemaVersion: 1,
    runs: [{
      candidateId: candidate.id, invocationId: 'failed-transport-invocation',
      fingerprint: 'a'.repeat(64), reviewerId: 'synthetic-code-reviewer', status: 'failed',
    }],
  }));

  const result = await ctx.call(ctx.event);
  assert.match(result?.reason ?? '', /E_REVIEW:/);
  assert.doesNotMatch(result?.reason ?? '', /E_REVIEW_PAUSE/);
  assert.equal(Object.hasOwn(JSON.parse(readFileSync(ctx.fixture.statePath, 'utf8')), 'reviewPause'), false);
});

test('aliased stall counters ignore unrelated PASS and REVISE rounds', async t => {
  const ctx = stalledReviewContext(t);
  const targetRounds = reviewPauseRounds().slice(0, 3).map((review, index) => ({
    ...review,
    seq: index + 1,
    lineageKey: 'prior-spec',
    candidateId: 'synthetic-spec',
    revision: `r${index + 1}`,
  }));
  writeReviewHistory(ctx, [
    ...targetRounds,
    { seq: 4, kind: 'round', lineageKey: 'other', candidateId: 'other-r1',
      revision: 'r4', verdict: 'PASS', findings: [], priorFindings: [] },
    { seq: 5, kind: 'round', lineageKey: 'other', candidateId: 'other-r2',
      revision: 'r5', verdict: 'REVISE', findings: [], priorFindings: [] },
    { seq: 6, kind: 'alias', lineageKey: 'synthetic-spec',
      from: 'prior-spec', to: 'synthetic-spec', authorityRef: 'C1 fixture' },
  ]);

  const result = await ctx.call(ctx.event);
  assert.match(result?.reason ?? '', /E_REVIEW_PAUSE/);
  const persisted = JSON.parse(readFileSync(ctx.record.registryPath, 'utf8'));
  assert.deepEqual(
    [persisted.candidates[0].nonPassStreak, persisted.candidates[0].noProgressCount],
    [3, 2],
  );
});

