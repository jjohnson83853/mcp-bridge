  "requirements": [
    {
      "id": "R1",
      "summary": "Single recovery locus: a new Store recovery method runs once per process between Open and startup admission; never in Reload, mid-run saves or ensureReplaceable"
    },
    {
      "id": "R2",
      "summary": "ErrCorrupt rejections and read failures of a regular snapshot file are quarantined by one atomic same-directory rename before any fresh snapshot is published; bytes preserved exactly"
    },
    {
      "id": "R3",
      "summary": "Non-regular snapshot files, rename failure and post-rename sync failure are fatal with code state_directory, kind resource and the underlying error logged, never internal_error"
    },
    {
      "id": "R4",
      "summary": "Exactly one structured startup_snapshot_rejected warn record per quarantined file with code snapshot_unavailable, resource.path and a finite failure_reason; no startup_failed/internal_error for quarantinable conditions"
    },
    {
      "id": "R5",
      "summary": "At most 5 quarantine files per family; the oldest beyond the bound is pruned after each rename; prune failure is non-fatal via internal_warning"
    },
    {
      "id": "R6",
      "summary": "Valid or absent snapshots: recovery mutates nothing — no rename, warning or retention pass; trusted state and no-overwrite protection untouched"
    },
    {
      "id": "R7",
      "summary": "prompts.json receives identical quarantine behavior with prompts.corrupt-*.json names and the same retention bound"
    },
    {
      "id": "R8",
      "summary": "MCP_SNAPSHOT_QUARANTINE=off disables recovery fail-closed with today's wedge semantics verbatim; any other value, including unset, enables recovery; default enabled [OWNER-CONFIRMED 2026-11-21]"
    },
    {
      "id": "R9",
      "summary": "Load/LoadPrompts rejections gain errors.Is-compatible reason sentinels chained under ErrCorrupt; existing callers and tests unaffected"
    }
  ],
