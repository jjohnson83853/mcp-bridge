  "requirements": [
    {
      "id": "R1",
      "summary": "Typed, sanitized startup cause: every non-diagnostic serve exit names its stage class plus bounded stage and static cause; no raw runtime error text; unknown errors keep a distinct class"
    },
    {
      "id": "R2",
      "summary": "Live diagnosis and fix of the mcp-bridge-network crash loop: record stage/cause from the live instance, reproduce with its actual config and state, fix, and hold RestartCount for at least ten minutes while serving"
    },
    {
      "id": "R3",
      "summary": "Last-known-good startup fallback: invalid active config plus a validated raw-byte sibling copy serves with exactly one config_degraded; active file untouched; no resolved secret in the copy or event; no fallback on reload"
    },
    {
      "id": "R4",
      "summary": "MCP_STRICT_CONFIG=true disables the fallback and keeps fail-closed behavior; default preserves R3"
    },
    {
      "id": "R5",
      "summary": "Every successful load emits exactly one config_loaded with the effective config path and resolved absolute storage directory; degraded start emits config_loaded then config_degraded"
    },
    {
      "id": "R6",
      "summary": "Document the config-file-relative base for storage.directory and the new events/fields; do not add a rejection for state inside the config directory"
    },
    {
      "id": "R7",
      "summary": "No secret value, bearer token, or credential appears in any startup event, degraded/loaded record, or persisted fallback copy"
    },
    {
      "id": "R8",
      "summary": "Compatibility and non-goals: no new dependency, no exit-code change, no breaker/reload/embedding/client-pause changes, check-config unchanged"
    }
  ],
