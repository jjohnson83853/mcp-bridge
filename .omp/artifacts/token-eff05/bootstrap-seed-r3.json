    "requirements": [
      {
        "id": "R1",
        "summary": "Exactly two allowlisted operations: portainer EndpointList and portainer docker_proxy path /containers/json; Proxmox/OPNsense excluded."
      },
      {
        "id": "R2",
        "summary": "Matching entry returns default projection by default and discloses entry/fields in every delivery path (direct, preview, pages, terminal); no unprojected objects remain when applied."
      },
      {
        "id": "R3",
        "summary": "Explicit full request returns unprojected upstream objects, still bounded by ticket 01 ceiling, retention and paging."
      },
      {
        "id": "R4",
        "summary": "Field selection overrides defaults, copies raw keys, rejects unknown fields only on non-empty lists; empty list+fields accepted; admission bounds 1-16 unique [A-Za-z0-9_] 1-64; full XOR fields."
      },
      {
        "id": "R5",
        "summary": "Allowlist entries are explicit identities justified by captured stored schemas and payload evidence; no patterns; non-matching docker_proxy paths labeled not_allowlisted."
      },
      {
        "id": "R6",
        "summary": "Errors, empty lists, carrier failures and shape changes degrade safely with disclosed/registered skip reasons; no partial projection; mode-partitioned skip/reject/accept rule."
      },
      {
        "id": "R7",
        "summary": "Non-allowlisted tools and unrequested calls remain byte-identical including page splits; disclosure in sizing maps only when present."
      }
    ],
