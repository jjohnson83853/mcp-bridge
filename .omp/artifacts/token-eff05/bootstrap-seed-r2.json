    "requirements": [
      {
        "id": "R1",
        "summary": "Exactly two allowlisted operations: portainer EndpointList and portainer docker_proxy path /containers/json; Proxmox/OPNsense excluded (conditional scope not exercised)."
      },
      {
        "id": "R2",
        "summary": "Matching entry returns documented default projection by default and discloses applied entry/fields in every delivery path (direct, preview, pages, terminal); no unprojected objects remain anywhere when disclosed applied."
      },
      {
        "id": "R3",
        "summary": "Explicit full request returns unprojected upstream objects, still bounded by ticket 01 delivery ceiling, retention and paging."
      },
      {
        "id": "R4",
        "summary": "Explicit field selection overrides defaults, copies raw top-level item keys, rejects unknown fields deterministically; admission bounds 1-16 unique strings <=64 bytes; full XOR fields."
      },
      {
        "id": "R5",
        "summary": "Allowlist entries are explicit identities (server, raw tool, discriminator) justified by captured stored schemas and payload evidence; no name patterns; other Docker paths unaffected."
      },
      {
        "id": "R6",
        "summary": "Errors, empty lists, non-list payloads and shape changes degrade safely by full pass-through with disclosed/registered skip reason; carrier completeness prevents partial projection."
      },
      {
        "id": "R7",
        "summary": "Non-allowlisted tools and unrequested calls remain byte-identical; no projection key in their outer envelope."
      }
    ],
