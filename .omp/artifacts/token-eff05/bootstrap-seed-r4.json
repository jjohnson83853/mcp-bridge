    "requirements": [
      {
        "id": "R1",
        "summary": "Exactly two allowlisted operations: portainer EndpointList and portainer docker_proxy path /containers/json; Proxmox/OPNsense excluded."
      },
      {
        "id": "R2",
        "summary": "Default projection on BOTH invocation surfaces with disclosure (call_tool projection member; direct mcp_bridge_projection carrier); no unprojected objects when applied."
      },
      {
        "id": "R3",
        "summary": "Explicit full via call_tool returns unprojected objects; direct path opt-out is the same tool via call_tool projection.full; ceiling preserved."
      },
      {
        "id": "R4",
        "summary": "Field selection overrides defaults, raw keys, unknown fields reject on non-empty lists, empty list+fields accepted, fields:[] rejected; bounds 1-16 unique [A-Za-z0-9_] 1-64 and <=512 encoded array bytes; full XOR fields."
      },
      {
        "id": "R5",
        "summary": "Allowlist entries explicit identities justified by captured schemas/payloads; no patterns; non-matching docker_proxy paths labeled not_allowlisted."
      },
      {
        "id": "R6",
        "summary": "Errors, empty lists, carrier failures, aggregate all-defaults-missing degrade with disclosed/registered skip reasons; mode-partitioned accept/skip/reject; no partial projection."
      },
      {
        "id": "R7",
        "summary": "Non-allowlisted tools and unrequested calls byte-identical including page splits; disclosure in sizing maps only when present."
      }
