    "requirements": [
      {
        "id": "R1",
        "summary": "Exactly two allowlisted operations: portainer EndpointList and portainer docker_proxy path /containers/json; Proxmox/OPNsense excluded (conditional scope not exercised)."
      },
      {
        "id": "R2",
        "summary": "Matching allowlist entry returns documented default field projection by default and discloses applied entry/fields in the response."
      },
      {
        "id": "R3",
        "summary": "Explicit full request returns unprojected upstream objects, still bounded by ticket 01 delivery ceiling, retention and paging."
      },
      {
        "id": "R4",
        "summary": "Explicit field selection overrides defaults, copies raw top-level item keys verbatim, and rejects unknown fields deterministically; full XOR fields."
      },
      {
        "id": "R5",
        "summary": "Allowlist entries are explicit identities (server, raw tool, operation discriminator) justified by captured stored schemas; no name patterns; other Docker paths unaffected."
      },
      {
        "id": "R6",
        "summary": "Errors, empty lists, non-list payloads and upstream shape changes degrade safely by full pass-through with disclosed and logged skip reason; no silent field dropping."
      },
      {
        "id": "R7",
        "summary": "Non-allowlisted tools and unrequested calls remain byte-identical; no projection key in their outer envelope."
      }
    ],
