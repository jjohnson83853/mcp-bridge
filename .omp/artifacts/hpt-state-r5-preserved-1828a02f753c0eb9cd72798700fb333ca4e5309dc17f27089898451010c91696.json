  "requirements": [
    {
      "id": "R1",
      "summary": "Header-bound calls transit in default stateless mode without a retained session"
    },
    {
      "id": "R2",
      "summary": "The SDK is the only emitter; the bridge ensures the execution session holds the tool definition"
    },
    {
      "id": "R3",
      "summary": "Body-only tools keep today's behavior, with no extra upstream RPC or header"
    },
    {
      "id": "R4",
      "summary": "Header-bound values stay in the arguments body; parameter headers are additive"
    },
    {
      "id": "R5",
      "summary": "Explicit stateful mode succeeds using cached definitions, refetching only when the TTL requires it"
    },
    {
      "id": "R6",
      "summary": "A legacy negotiated protocol yields parameter_header_unsupported with not_started and zero executions"
    },
    {
      "id": "R7",
      "summary": "The protocol boundary, operator handling and definition-pass cost are documented"
    },
    {
      "id": "R8",
      "summary": "Failure paths stay payload-free in the closed vocabulary plus one additive reason token"
    },
    {
      "id": "R9",
      "summary": "A deterministic peer-based reproduction records wire facts in both modes"
    },
    {
      "id": "R10",
      "summary": "The deployed github upstream is verified end to end under operator gate"
    },
    {
      "id": "R11",
      "summary": "Stateless restart resilience is preserved"
    }
  ],
