    "verdict": "REQUEST CHANGES",
    "findings": [
      {
        "id": "CR7-1",
        "class": "statement-contradiction",
        "severity": "MEDIUM",
        "title": "The documented `snapshot_retention_failed` remediation cannot be emitted by the specified code path",
        "anchor": ".scratch/snapshot-recovery/spec.md",
        "fix": "Set the new AD13 row and §7 remediation to the shared text `verify the durable snapshot and storage permissions, then retry` (no code, field, id or schema change), and add an `error.remediation` assertion to AC1-5b so the emitted value is pinned."
      },
      {
        "id": "CR7-2",
        "class": "r-ac-coverage-gap",
        "severity": "LOW",
        "title": "R4's per-file quantifier is only exercised with one quarantined file",
        "anchor": ".scratch/snapshot-recovery/spec.md",
        "fix": "Add a both-corrupt subcase (no new id) asserting two R4 records discriminating the families by `quarantine_path`."
      },
      {
        "id": "CR7-3",
        "class": "editorial",
        "severity": "LOW",
        "title": "§7 calls `quarantine_path` a \"state-directory-relative filename\"",
        "anchor": ".scratch/snapshot-recovery/spec.md",
        "fix": "Reword §7 to \"absolute quarantine file path inside the state directory\"."
      },
      {
        "id": "CR7-4",
        "class": "editorial",
        "severity": "LOW",
        "title": "Ticket mirror is stale for the r7 in-place amendments",
        "anchor": ".scratch/snapshot-recovery/issues/01-untrusted-snapshot-self-recovery.md:88-113",
        "fix": "Re-mirror AC1-3/AC1-9 (and the amended-id list) from spec r7."
      },
      {
        "id": "CR7-5",
        "class": "ac-not-falsifiable",
        "severity": "LOW",
        "title": "AC1-9's \"only older pre-existing conforming files were pruned\" is ambiguous",
        "anchor": ".scratch/snapshot-recovery/spec.md",
        "fix": "Replace with \"the 4 newest pre-existing conforming names survive; the oldest pre-existing name is removed\"."
      },
      {
        "id": "CR7-6",
        "class": "editorial",
        "severity": "LOW",
        "title": "AC2-5 does not exercise the rename-failure route it names",
        "anchor": ".scratch/snapshot-recovery/spec.md",
        "fix": "State that AC2-5 asserts the Open/state-directory route and that AC2-8(b) is the rename-class oracle."
      }
    ],
