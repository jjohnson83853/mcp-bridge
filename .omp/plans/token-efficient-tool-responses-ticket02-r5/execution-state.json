  "requirements": [
    {
      "id": "R1",
      "summary": "Compact index hits — exactly tool_name, normalized bounded one-line description, score; no schema content; describe_tool remains the only schema path."
    },
    {
      "id": "R2",
      "summary": "Small enforced limits — effective default min(operator default,3) and max min(operator max,4) for valid operator configs; above-max top_k rejected; advertised schema equals enforced caps."
    },
    {
      "id": "R3",
      "summary": "Root envelope preserved; match_count and truncated added only when clipped; ranking, filters, degradation and revision behavior unchanged."
    },
    {
      "id": "R4",
      "summary": "Byte target and tests — complete serialized CallToolResult <=2048 bytes including duplicated text re-escaping; default, cap, clip, normalization/bounding and byte-bound tests."
    },
    {
      "id": "R5",
      "summary": "Documentation — README and live guidance document compact fields, removals, additions, caps, 36-byte budget, <=2048 target and describe_tool-only schemas (ticket Notes only)."
    }
