  "requirements": [
    {
      "id": "R1",
      "summary": "Compact index hits — exactly tool_name, bounded one-line description, score; no schema content; describe_tool remains the only schema path."
    },
    {
      "id": "R2",
      "summary": "Small enforced limits — effective default min(operator default,3) and caller-visible max min(operator max,4); above-max top_k rejected, never clamped; advertised schema equals enforced bounds."
    },
    {
      "id": "R3",
      "summary": "Root envelope preserved (catalog_revision, mode, degraded_reasons); match_count and truncated added only when clipped; ranking, filters, degradation and revision behavior unchanged."
    },
    {
      "id": "R4",
      "summary": "Byte target and tests — complete serialized CallToolResult <=2048 bytes at maximum results with long names/descriptions; default, cap rejection, clip metadata, description bounding and byte bound tested."
    },
    {
      "id": "R5",
      "summary": "Documentation — README and live search_tools guidance document compact fields, removals, additions, caps, description budget and describe_tool-only schemas."
    }
