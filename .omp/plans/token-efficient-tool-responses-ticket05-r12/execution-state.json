  "requirements": [
    {
      "id": "R1",
      "summary": "Exactly two allowlisted operations: portainer EndpointList and portainer docker_proxy path /containers/json; Proxmox/OPNsense excluded."
    },
    {
      "id": "R2",
      "summary": "Default projection on both paths with ONE disclosure schema {v,applied,entry,mode,fields,reason?}; fields=[] when nothing applied, entry=\"\" when no match; whole upstream_result re-derived."
    },
    {
      "id": "R3",
      "summary": "Explicit full via call_tool returns unprojected objects; direct-path opt-out via call_tool projection.full; ceiling preserved."
    },
    {
      "id": "R4",
      "summary": "Field selection overrides defaults, raw keys, unknown fields reject on non-empty lists, empty list+fields accepted, fields:[] rejected; bounds + runtime-derived budget; full XOR fields."
    },
    {
      "id": "R5",
      "summary": "Allowlist entries explicit identities justified by captured schemas/payloads; no patterns; non-matching docker_proxy paths labeled not_allowlisted."
    },
    {
      "id": "R6",
      "summary": "Errors, empty lists, carrier failures, non-empty aggregate all-defaults-missing, non-object items, direct collisions degrade with per-row disclosure channels; forged members never bridge-authoritative."
    },
    {
      "id": "R7",
      "summary": "Non-allowlisted tools and calls with no projection request byte-identical including page splits on both paths; disclosure metadata only when budget admits; engine decision out-of-band."
    }
  ],
