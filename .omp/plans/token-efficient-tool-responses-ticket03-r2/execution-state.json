  "requirements": [
    {
      "id": "R1",
      "summary": "Search does not mutate session projection; no tools appear in later lists solely from a match."
    },
    {
      "id": "R2",
      "summary": "Expose_tools is the only unpinned-exposure path: 1..8 unique catalog names, atomic deterministic outcomes."
    },
    {
      "id": "R3",
      "summary": "Configured pins unchanged in publisher and session projections; exposing a pin is a no-op."
    },
    {
      "id": "R4",
      "summary": "Direct-call eligibility unchanged for never-pinned/never-exposed tools; call_tool and retrieve_result untouched."
    },
    {
      "id": "R5",
      "summary": "Exposed tools are isolated to the requesting session; other sessions unchanged."
    },
    {
      "id": "R6",
      "summary": "Catalog revision, owner, epoch and registry checks preserved and revalidated during exposure."
    },
    {
      "id": "R7",
      "summary": "Describe_tool never mutates the session projection."
    },
    {
      "id": "R8",
      "summary": "Automated coverage for no-fanout, exposure success, bound rejection, pins, isolation."
    }
  ],
