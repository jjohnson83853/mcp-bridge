  "requirements": [
    {
      "id": "R1",
      "summary": "Exactly two allowlisted operations: portainer EndpointList and portainer docker_proxy path /containers/json; Proxmox/OPNsense excluded."
    },
    {
      "id": "R2",
      "summary": "Default projection on both invocation paths with ONE normative disclosure schema {v,applied,entry,mode,fields,reason?}; whole upstream_result re-derived; no unprojected carriers when applied."
    },
    {
      "id": "R3",
      "summary": "Explicit full via call_tool returns unprojected objects; direct-path opt-out is the same tool via call_tool projection.full; ceiling preserved."
    },
    {
      "id": "R4",
      "summary": "Field selection overrides defaults, raw keys, unknown fields reject on non-empty lists, empty list+fields accepted, fields:[] rejected; count/length/alphabet bounds + runtime-derived budget; full XOR fields."
    },
    {
      "id": "R5",
      "summary": "Allowlist entries explicit identities justified by captured schemas/payloads; no patterns; non-matching docker_proxy paths labeled not_allowlisted."
    },
    {
      "id": "R6",
      "summary": "Errors, empty lists, carrier failures, aggregate all-defaults-missing, non-object items, direct collisions degrade with per-row disclosure channels; no partial projection."
    },
    {
      "id": "R7",
      "summary": "Non-allowlisted tools and unrequested calls byte-identical including page splits on both paths; disclosure metadata only when budget admits; engine decision out-of-band, never re-parsed."
    }
  ],
