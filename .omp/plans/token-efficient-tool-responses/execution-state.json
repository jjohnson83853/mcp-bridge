  "requirements": [
    {
      "id": "R1",
      "summary": "Over-ceiling results deliver a bounded preview (<=1536 bytes) plus an opaque handle reporting total_bytes and paging_required"
    },
    {
      "id": "R2",
      "summary": "Results at or below the 8192-byte ceiling are delivered byte-identically to today; 8193 pages"
    },
    {
      "id": "R3",
      "summary": "Each page is <=8192 serialized bytes and reports page, total_pages, remaining_pages, total_bytes, remaining_bytes"
    },
    {
      "id": "R4",
      "summary": "Concatenated pages reproduce the unbounded serialized result byte-exactly and are stable until expiry or eviction"
    },
    {
      "id": "R5",
      "summary": "Pages are valid UTF-8 across boundaries and the ceiling measures post-escape serialized bytes"
    },
    {
      "id": "R6",
      "summary": "The retrieval surface, parameters and preview/page contract are documented and require no output-shape prediction"
    },
    {
      "id": "R7",
      "summary": "Handles are crypto-random, content-independent and incarnation-bound; unknown, tampered or foreign handles are rejected indistinguishably"
    },
    {
      "id": "R8",
      "summary": "Expired and evicted handles fail with distinct typed codes, never an empty or partial success"
    },
    {
      "id": "R9",
      "summary": "Retained storage is bounded per session and in aggregate with deterministic eviction and no cross-session eviction"
    },
    {
      "id": "R10",
      "summary": "Oversized isError results keep error status and code; bridge dispatch failures keep their small typed shape"
    },
    {
      "id": "R11",
      "summary": "The ceiling applies identically to call_tool, directly invoked projected tools, search_tools and describe_tool"
    },
    {
      "id": "R12",
      "summary": "Durable behavioral tests cover R1-R11 including boundary, reconstruction, UTF-8, isolation, expiry, eviction and serialization bounds"
    }
  ],
