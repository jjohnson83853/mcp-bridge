  "decisions": [
    {
      "id": "D-OD1",
      "inputDigest": "653398516c85e6cc81703e1c1de2dc9091e97ad9decc22ab5f20376f7a2c3c7b",
      "kind": "technical",
      "status": "resolved",
      "question": "Which caller-visible surface should retrievable results use?",
      "answer": "A fourth first-class built-in tool `retrieve_result` (planner recommendation OD1-A). Existing stored schemas are unchanged and the contract stays explicit.",
      "rationale": "RULES.md S06: adopt the conservative documented recommendation of the planning specialist rather than leaving a reversible default open.",
      "sourceIds": [
        "src-owner-kickoff"
      ],
      "affects": [
        "R6",
        "T3",
        "AC6"
      ]
    },
    {
      "id": "D-OD2",
      "inputDigest": "9231bb5069888087f5120035bb3347fb881ef9d71d5b6e0f5b66c7ea5790d8de",
      "kind": "technical",
      "status": "resolved",
      "question": "What retained-result storage bounds apply by default?",
      "answer": "Planner recommendation OD2-A: 16 entries and 8 MiB per session, 64 MiB aggregate, 8 MiB max retained result, 1h TTL.",
      "rationale": "RULES.md S06: adopt the conservative documented recommendation of the planning specialist rather than leaving a reversible default open.",
      "sourceIds": [
        "src-owner-kickoff"
      ],
      "affects": [
        "R9",
        "T2",
        "AC9"
      ]
    },
    {
      "id": "D-OD3",
      "inputDigest": "5f182f8f37848575039eda4883055a5fe24fa4d15d0f734583927473ae7343c1",
      "kind": "technical",
      "status": "resolved",
      "question": "What handle expiry policy applies?",
      "answer": "Planner recommendation OD3-A: fixed 1h handle_ttl plus purge on session idle-retire/delete.",
      "rationale": "RULES.md S06: adopt the conservative documented recommendation of the planning specialist rather than leaving a reversible default open.",
      "sourceIds": [
        "src-owner-kickoff"
      ],
      "affects": [
